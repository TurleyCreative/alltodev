  html += '</div>';
  html += '<div class="rs"><div class="st">Clip Map</div>';
  html += '<div class="lr"><span class="ll">Hide map content in zone area</span>'
    + '<button class="tg'+(z.clipMap?' on':'')+' " id="zn-clip-tog"></button></div>';
  html += '<div class="nt" style="margin-top:4px;font-size:11px;color:var(--ghost)">Hides Mapbox buildings &amp; labels inside this zone. Use with \'Render as 3D building\' to show only your custom content.</div>';
  html += '</div>';
  // Scene visibility checklist
  html += '<div class="rs"><div class="st">Visible on scenes</div>';
  html += '<div class="nt" style="margin-bottom:8px">Tick the scenes where this zone should appear. Leave all unticked to hide everywhere.</div>';
  var zScenes = z.scenes || [];
  if(!P.scenes.length) {
    html += '<div style="font-size:11px;color:var(--ghost);font-family:var(--mono)">No scenes yet — add scenes first.</div>';
  } else {
    P.scenes.forEach(function(sc, si) {
      var checked = zScenes.indexOf(sc.id) >= 0;
      html += '<div class="lr" style="margin-bottom:5px">'
        + '<span class="ll">'+h(sc.label||'Scene '+(si+1))+'</span>'
        + '<button class="tg'+(checked?' on':'')+'" id="zn-sc-'+si+'"></button>'
        + '</div>';
    });
  }
  html += '</div>';
  // Accessibility drawer visibility
  html += '<div class="rs"><div class="lr"><span class="ll">Show in accessibility drawer</span>'
    + '<button class="tg'+(z.showInDrawer!==false?' on':'')+'" id="zn-showdrawer-tog"></button></div>';
  html += '<div class="nt" style="margin-top:4px">Lists this zone in the keyboard/screen-reader "Map Contents" panel. Turn off for zones that don\'t need a text-based entry, e.g. a clip mask used only to hide existing buildings.</div>';
