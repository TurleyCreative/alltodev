// ═══════════════════════════════════════════════════
function buildCfg() {
  // Inject custom colour/font overrides as CSS variables
  // Always emit all custom properties so output always matches editor settings
  var acc  = P.accentColor   || '#c0392b';
  var paper= P.paperColor    || '#f8f6f1';
  var teal = P.progressColor || '#2a7c6b';
  var font = P.fontFamily    || 'tt-commons-pro';
  var customCSS = '--accent:'+acc+';--red:'+acc+';--paper:'+paper+';--teal:'+teal+';--f-body:"'+font+'",system-ui,sans-serif;';
  var customStyleTag = customCSS ? '\n<style>:root{'+customCSS+'}</style>' : '';
  var typekitId = P.typekitId || 'dfg2dug';

  // Build overlay config
  // Lines config
  var lnData = (P.lines||[]).map(function(ln) {
    var sceneIdxs = (ln.scenes||[]).map(function(sid){
      var si=P.scenes.findIndex(function(s){return s.id===sid;}); return si>=0?si:-1;
    }).filter(function(si){return si>=0;});
    return JSON.stringify({
      color:ln.color||'#fff', width:ln.width||3, opacity:ln.opacity||1,
      dash:ln.dash||'solid',
      showEndpoints:!!ln.showEndpoints, endpointRadius:ln.endpointRadius||5,
      showLabel:!!ln.showLabel, labelText:ln.labelText||ln.name||'',
      labelSize:ln.labelSize||12, labelColor:ln.labelColor||'#fff',
      scenes:sceneIdxs,
      geojson:ln.geojson||'',
      animOverride:!!ln.animOverride, animDuration:ln.animDuration||800, animEasing:ln.animEasing||'easeOut', animDelay:ln.animDelay||0, animEasingCurve:ln.animEasingCurve||[0.42,0,0.58,1]
    });
  });

  var ovLines = (P.overlays||[]).filter(function(ov){ return ov.url&&ov.coords&&ov.coords.length>=4; }).map(function(ov,i) {
    var sceneIdxs = (ov.scenes||[]).map(function(sid){
      var si=P.scenes.findIndex(function(s){return s.id===sid;}); return si>=0?si:-1;
    }).filter(function(si){return si>=0;});
    return JSON.stringify({id:ov.id||('ov'+i),name:ov.name,url:ov.url,opacity:ov.opacity||0.85,
      global:!!ov.global,scenes:sceneIdxs,
      coords:[ov.coords[0],ov.coords[1],ov.coords[2],ov.coords[3]]});
  });

  var scenes = P.scenes.map(function(sc, i) {
    return '  {\n'
      + '    label: ' + JSON.stringify(sc.label||('Scene '+(i+1))) + ',\n'
      + '    camera: { center:SITE_CENTRE, zoom:'+((sc.camera&&sc.camera.zoom)||14)+', pitch:'+((sc.camera&&sc.camera.pitch)||0)+', bearing:'+((sc.camera&&sc.camera.bearing)||0)+', duration:'+((sc.camera&&sc.camera.duration)||2000)+' },\n'
      + '    layers: { redline:'+!!(sc.layers&&sc.layers.redline)+', context:'+!!(sc.layers&&sc.layers.context)+', constraints:'+!!(sc.layers&&sc.layers.constraints)+', buildings3d:'+!!(sc.layers&&sc.layers.buildings3d)+', orbit:'+!!(sc.layers&&sc.layers.orbit)+' }\n'
      + '  }';
  }).join(',\n');

  var labels = P.scenes.map(function(sc){return JSON.stringify(sc.label||'Scene');}).join(',');

  var markers = {type:'FeatureCollection',features:P.markers.map(function(m){return{type:'Feature',geometry:{type:'Point',coordinates:m.coords},properties:{name:m.name,desc:m.desc,icon:m.icon||'',color:m.color,flyCamera:!!m.flyCamera,camZoom:m.camZoom||15,camPitch:m.camPitch||45,camBearing:m.camBearing||0,lightboxEnabled:!!(m.lightbox&&m.lightbox.enabled),lightboxLayout:(m.lightbox&&m.lightbox.layout)||'card',lightboxHeading:(m.lightbox&&m.lightbox.heading)||'',lightboxSubheading:(m.lightbox&&m.lightbox.subheading)||'',lightboxBody:(m.lightbox&&m.lightbox.body)||'',lightboxImg:(m.lightbox&&m.lightbox.img)||'',lightboxImgCaption:(m.lightbox&&m.lightbox.imgCaption)||'',lightboxImages:JSON.stringify((m.lightbox&&m.lightbox.images)||[]),lightboxEmbedUrl:(m.lightbox&&m.lightbox.embedUrl)||'',scenes:(m.scenes||[]).map(function(sid){var si=P.scenes.findIndex(function(s){return s.id===sid;});return si>=0?si:-1;}).filter(function(si){return si>=0;}).join(','),showInDrawer:m.showInDrawer!==false}};})};

  var constraints = {type:'FeatureCollection',features:P.zones.map(function(z){var zco=z.smoothRadius>0.01?smoothPolygon(z.coordinates,z.smoothRadius):z.coordinates;var zlb=z.lightbox||{};return{type:'Feature',geometry:{type:'Polygon',coordinates:[zco]},properties:{id:z.id||z.name,name:z.name,color:z.color,opacity:z.opacity,scenes:(z.scenes||[]).map(function(sid){var si=P.scenes.findIndex(function(s){return s.id===sid;});return si>=0?si:-1;}).filter(function(si){return si>=0;}).join(','),showHover:z.showHover!==false,extrude:!!z.extrude,extrudeHeight:z.extrudeHeight||20,render3d:!!z.render3d,height3d:z.height3d||20,clipMap:!!z.clipMap,lightboxEnabled:!!zlb.enabled,lightboxLayout:zlb.layout||'popover',lightboxHeading:zlb.heading||'',lightboxSubheading:zlb.subheading||'',lightboxBody:zlb.body||'',lightboxImg:zlb.img||'',lightboxImgCaption:zlb.imgCaption||'',lightboxEmbedUrl:zlb.embedUrl||'',showInDrawer:z.showInDrawer!==false}};})};

  var ciLines = P.zones.map(function(z){return '  '+JSON.stringify(z.id||z.name)+': { title:'+JSON.stringify(z.name)+', body:'+JSON.stringify(z.popup||'')+' }';}).join(',\n');

  return [
    'var BLD_COLOR = ' + JSON.stringify(P.buildingColor||'#2a3a4a') + ';',
    'var CLIP_COLOR = ' + JSON.stringify(P.paperColor||'#f8f6f1') + ';',
    'var BUILDINGS = [' + (P.buildings||[]).map(function(b){
      var sceneIdxs = (b.scenes||[]).map(function(sid){
        var si=P.scenes.findIndex(function(s){return s.id===sid;}); return si>=0?si:-1;
      }).filter(function(si){return si>=0;});
      return JSON.stringify({color:b.color||'#8899aa',height:b.height||20,opacity:b.opacity||0.85,scenes:sceneIdxs,geojson:b.geojson||''});
    }).join(',') + '];',
    'var MAPBOX_TOKEN = ' + JSON.stringify(P.mapboxToken||'') + ';',
    'var MAPBOX_STYLE = ' + JSON.stringify(P.mapboxStyle||'mapbox://styles/mapbox/dark-v11') + ';',
    'var ANIMATE_ENTRANCES = ' + (P.animateEntrances!==false) + ';',
    'var ANIM_DURATION = ' + (P.animDuration||800) + ';',
    'var ANIM_DELAY = ' + (P.animDelay||0) + ';',
    'var ANIM_EASING = ' + JSON.stringify(P.animEasing||'easeOut') + ';',
    'var ANIM_EASING_CURVE = ' + JSON.stringify(P.animEasingCurve||[0.42,0,0.58,1]) + ';',
    'var SITE_CENTRE  = [' + P.siteCentre[0] + ', ' + P.siteCentre[1] + '];',
    'var SITE_PIN_LABEL = ' + JSON.stringify(P.sitePinLabel||'The Site') + ';',
    'var SHEETDB_URL  = ' + JSON.stringify(P.sheetdbUrl||'') + ';',
    'var QUESTIONS_SHEETDB_URL = ' + JSON.stringify(P.questionsSheetdbUrl||'') + ';',
    'var RED_LINE = { type:"Feature", geometry:{ type:"Polygon", coordinates:' + JSON.stringify([P.redLine.coordinates]) + ' }, properties:{} };',
    'var CONTEXT_MARKERS = ' + JSON.stringify(markers) + ';',
    'var CONSTRAINTS = ' + JSON.stringify(constraints) + ';',
    'var CONSTRAINT_INFO = {\n' + ciLines + '\n};',
    'var CATEGORY_COLOURS = { "Support":"#2a7c6b","Object":"#c0392b","Question":"#d4820a","General":"#2255aa" };',
    'var SCENES = [\n' + scenes + '\n];',
    'var SCENE_LABELS = [' + labels + '];',
    'var LINES=['+lnData.join(',')+'];',
    'var OVERLAYS=['+ovLines.join(',')+'];',
  ].join('\n');
}

