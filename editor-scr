function renderOnboarding() {
  var steps = [
    {done: P.mapboxToken.length > 0,       num:'1', label:'Add your Mapbox token',   hint:'Settings > Map > Mapbox Token. Free at mapbox.com'},
    {done: !(P.siteCentre[0]===-2.2345),   num:'2', label:'Set your site location',  hint:'Settings > Map > use the Map button or enter coordinates'},
    {done: P.redLine.coordinates.length>3, num:'3', label:'Draw your red line',       hint:'Draw on geojson.io > Settings > Red Line Boundary > paste'},
    {done: P.scenes.length > 1,            num:'4', label:'Add your scenes',          hint:'Scenes tab > use Quick Presets to set up each scene'},
    {done: P.markers.length > 0,           num:'5', label:'Place context markers',    hint:'Markers tab > add markers and click the map to place'},
    {done: P.sheetdbUrl.length > 0,        num:'6', label:'Connect SheetDB feedback', hint:'Settings > Have Your Say > follow the setup guide'},
  ]
  var done = steps.filter(function(s){return s.done;}).length;
  var html = '<div class="rh"><div class="re">Getting started</div><div class="rt">Setup checklist</div></div>';
  html += '<div class="rs">';
  html += '<div style="margin-bottom:14px">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">';
  html += '<span style="font-size:11px;color:var(--ghost);font-family:var(--mono)">'+done+' / '+steps.length+' complete</span>';
  html += '</div>';
  // Progress bar
  html += '<div style="height:4px;background:var(--border2);border-radius:2px;overflow:hidden">';
  html += '<div style="height:100%;background:var(--accent2);width:'+(done/steps.length*100)+'%;transition:width .4s;border-radius:2px"></div>';
  html += '</div></div>';
  steps.forEach(function(s, si) {
    var bg = s.done ? 'rgba(74,155,127,.1)' : 'rgba(255,255,255,.02)';
    var border = s.done ? '1px solid rgba(74,155,127,.3)' : '1px solid var(--border)';
    var checkCol = s.done ? '#2a7c6b' : 'var(--border2)';
    html += '<div class="ob-step" data-si="'+si+'" style="padding:11px 13px;border-radius:9px;background:'+bg+';border:'+border+';margin-bottom:7px;cursor:pointer">';
    html += '<div style="display:flex;align-items:center;gap:10px">';
    html += '<div style="width:20px;height:20px;border-radius:50%;background:'+checkCol+';display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;color:#fff;font-weight:500">'+(s.done?lucideSVG('check',12,'#fff'):s.num)+'</div>';
    html += '<div><div style="font-size:13px;font-weight:500;color:var(--ink)">'+(s.done?'<span style="opacity:.4;text-decoration:line-through">'+s.label+'</span>':s.label)+'</div>';
    html += '<div style="font-size:11px;color:var(--ghost);font-family:var(--mono);margin-top:2px">'+s.hint+'</div></div>';
    html += '</div></div>';
  });
  if(done === steps.length) {
    html += '<div style="padding:15px;border-radius:9px;background:rgba(74,155,127,.12);border:1px solid rgba(74,155,127,.3);text-align:center">';
    html += '<div style="font-size:14px;font-weight:500;color:#2a7c6b;margin-bottom:4px" class="ico-h">'+lucideSVG('check-circle',14,'#2a7c6b')+'All set!</div>';
    html += '<div style="font-size:11px;color:var(--ghost)">Your consultation is ready. Hit Download to export.</div></div>';
  }
  html += '</div>';
  setHTML('rpc', html);
  // Bind step clicks
  var stepActions = [
    function(){switchMain('settings');},
    function(){switchMain('settings');},
    function(){switchMain('settings');},
    function(){switchTab('sc');},
    function(){switchTab('mk');},
    function(){switchMain('settings');}
  ];
  document.querySelectorAll('.ob-step').forEach(function(stepEl) {
    stepEl.addEventListener('click', function() {
      var si = parseInt(this.dataset.si);
      if(stepActions[si]) stepActions[si]();
      renderRightPanel();
    });
  });
}

