    : (isLucide(curIcon) ? lucideSVG(curIcon,20,'rgba(255,255,255,.9)') : (curIcon || '&nbsp;'));
  html += '<div class="f"><label class="fl">Icon</label>';
  html += '<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">';
  html += '<div class="icon-preview" id="mk-icon-preview">'+previewContent+'</div>';
  html += '<span style="font-size:11px;font-family:var(--mono);color:var(--ghost)">Select below, type/paste any emoji, or upload your own</span>';
  html += '</div>';
  html += '<input type="text" id="mk-icon" value="'+h((curIcon&&curIcon.indexOf('data:')===0)?'':curIcon)+'" placeholder="e.g. map-pin or paste emoji" style="margin-bottom:8px"/>';
  html += '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
    + '<label class="btn btn-g btn-ic" style="cursor:pointer;font-size:11px;padding:6px 12px">'+lucideSVG('upload',12,'currentColor')+'Upload SVG icon<input type="file" id="mk-icon-upload" accept=".svg,image/svg+xml" style="display:none"/></label>'
    + '<span id="mk-icon-upload-status" style="font-size:10px;color:var(--ghost)"></span>'
    + '</div>';

  // Icon grid grouped by category
  html += '<div id="mk-icon-grid" style="max-height:200px;overflow-y:auto;padding:6px;background:var(--bg);border:1px solid var(--border2);border-radius:9px;scrollbar-width:thin">';
  Object.keys(ICONS).forEach(function(cat) {
    html += '<div style="font-size:10px;color:var(--ghost);padding:4px 2px 3px;font-weight:500">'+cat+'</div>';
    html += '<div style="display:grid;grid-template-columns:repeat(9,1fr);gap:3px;margin-bottom:6px">';
    ICONS[cat].forEach(function(name) {
      var isSel = (curIcon === name);
      html += '<button class="icon-btn'+(isSel?' on':'')+'" data-ico="'+name+'" title="'+name+'" aria-label="'+name+'" style="width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:'+(isSel?'var(--accent)':'var(--mid)')+';border:1px solid '+(isSel?'var(--accent)':'var(--border2)')+';border-radius:6px;cursor:pointer;padding:0">'
        + lucideSVG(name,15,isSel?'#fff':'var(--ghost)')
        + '</button>';
    });
    html += '</div>';
  });
  html += '</div>';
  html += '</div>'; // close .f
  html += '</div>'; // close .rs (Details)

  // Position section
  html += '<div class="rs"><div class="st">Position</div>';
  html += '<button class="btn btn-g btn-ic" id="mk-place-btn" style="width:100%;margin-bottom:8px;justify-content:center">'+lucideSVG('crosshair',13,'currentColor')+'Click map to place</button>';
  html += '<div class="nt">Or enter coordinates manually:</div>';
  html += '<div class="f2"><div class="f">'+fldInner('Longitude','mk-lng',m.coords[0])+'</div>';
  html += '<div class="f">'+fldInner('Latitude','mk-lat',m.coords[1])+'</div></div>';
  html += '</div>';
  // Scene visibility checklist
  html += '<div class="rs"><div class="st">Visible on scenes</div>';
  html += '<div class="nt" style="margin-bottom:8px">Tick the scenes where this marker should appear. Leave all unticked to hide everywhere.</div>';
  var mScenes = m.scenes || [];
  if(!P.scenes.length) {
    html += '<div style="font-size:11px;color:var(--ghost);font-family:var(--mono)">No scenes yet — add scenes first.</div>';
  } else {
    P.scenes.forEach(function(sc, si) {
      var checked = mScenes.indexOf(sc.id) >= 0;
      html += '<div class="lr" style="margin-bottom:5px">'
        + '<span class="ll">'+h(sc.label||'Scene '+(si+1))+'</span>'
        + '<button class="tg'+(checked?' on':'')+'" id="mk-sc-'+si+'"></button>'
        + '</div>';
    });
  }
  html += '</div>';

  // Accessibility drawer visibility
  html += '<div class="rs"><div class="lr"><span class="ll">Show in accessibility drawer</span>'
    + '<button class="tg'+(m.showInDrawer!==false?' on':'')+'" id="mk-showdrawer-tog"></button></div>';
  html += '<div class="nt" style="margin-top:4px">Lists this marker in the keyboard/screen-reader "Map Contents" panel. Turn off for markers that don\'t need a text-based entry, e.g. purely decorative pins.</div>';
  html += '</div>';

  // Colour section
  html += '<div class="rs"><div class="st">Colour</div>';
  // Quick colour presets
  var colPresets = ['#2255aa','#c0392b','#d4820a','#2a7c6b','#8b5cf6','#0f0e0d','#4a7bc8','#e05a2b'];
  html += '<div style="display:flex;gap:8px;padding:4px 2px;margin-bottom:8px">';
  colPresets.forEach(function(col) {
    var sel = m.color===col ? 'outline:2px solid #fff;outline-offset:2px;' : '';
    html += '<div data-col="'+col+'" style="width:22px;height:22px;border-radius:50%;background:'+col+';cursor:pointer;flex-shrink:0;transition:transform .15s;'+sel+'" title="'+col+'"></div>';
  });
  html += '</div>';
  html += '<div class="f"><div class="cr"><input type="color" id="mk-col-p" value="'+h(m.color)+'"/>';
  html += '<input type="text" id="mk-col-t" value="'+h(m.color)+'"/></div></div>';
  html += '</div>';

  // Camera Preset section
  html += '<div class="rs"><div class="st">Camera Preset</div>';
  html += '<div class="lr"><span class="ll">Fly to camera on click</span>'
    + '<button class="tg'+(m.flyCamera?' on':'')+' " id="mk-fly-tog"></button></div>';
  if(m.flyCamera){
    html += fld('Zoom','mk-cam-zoom',m.camZoom||15);
    html += fld('Pitch','mk-cam-pitch',m.camPitch||45);
    html += fld('Bearing','mk-cam-bearing',m.camBearing||0);
    html += '<div style="display:flex;gap:6px;margin-top:4px">';
    html += '<button class="btn btn-g btn-ic" id="mk-cam-use-view" style="flex:1;justify-content:center">'+lucideSVG('camera',13,'currentColor')+'Use current view</button>';
    html += '<button class="btn btn-g btn-ic" id="mk-cam-preview" style="flex:1;justify-content:center">'+lucideSVG('play',13,'currentColor')+'Preview</button>';
    html += '</div>';
  }
  html += '</div>';

  // Lightbox section
  html += '<div class="rs"><div class="st">Lightbox <small style="font-family:var(--mono);font-size:9px;color:var(--ghost);margin-left:4px">(optional)</small></div>';
  html += '<div class="lr" style="margin-bottom:12px"><span class="ll">Enable lightbox popup</span>';
  html += '<button class="tg'+(lb.enabled?' on':'')+'" id="mk-lb-tg"></button></div>';
  if(lb.enabled) {
    // Layout picker
    var lbLayouts = [{id:'full',label:'Full Panel',desc:'iframe, no text'},{id:'image-text',label:'Image + Text',desc:'40/60 split'},{id:'iframe-text',label:'Iframe + Text',desc:'40/60 interactive'},{id:'popover',label:'Popover',desc:'Text near marker'}];
    html += '<div class="f"><label class="fl">Layout</label>';
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:4px">';
    lbLayouts.forEach(function(l) {
      var sel = (lb.layout||'popover')===l.id;
      html += '<button data-layout="'+l.id+'" style="padding:8px 6px;border-radius:5px;border:1px solid '+(sel?'var(--accent)':'var(--border2)')+';background:'+(sel?'rgba(32,122,182,.1)':'var(--bg)')+';cursor:pointer;text-align:left">'
        + '<div style="font-size:12px;font-weight:500;color:var(--ink);margin-bottom:2px">'+l.label+'</div>'
        + '<div style="font-size:9px;color:var(--ghost);font-family:var(--mono)">'+l.desc+'</div>'
        + '</button>';
    });
    html += '</div></div>';
    var lbLy = lb.layout||'popover';
    if(lbLy !== 'full') {
      html += '<div class="f"><label class="fl">Heading</label><input type="text" id="mk-lb-head" value="'+h(lb.heading||'')+'" placeholder="Main heading"/></div>';
      html += '<div class="f"><label class="fl">Subheading</label><input type="text" id="mk-lb-subhead" value="'+h(lb.subheading||'')+'" placeholder="Optional subheading"/></div>';
    }
    html += '<div class="f"><label class="fl">Body text <span style="font-size:9px;color:var(--ghost);font-family:var(--mono);font-weight:400;margin-left:4px">supports HTML</span></label>';
    html += '<div id="mk-lb-toolbar" style="display:flex;gap:3px;margin-bottom:5px;flex-wrap:wrap">';
    var tbBtns = [
      {cmd:'bold',      label:'<b>B</b>',       title:'Bold'},
      {cmd:'italic',    label:'<i>I</i>',        title:'Italic'},
      {cmd:'insertUnorderedList', label:lucideSVG('list',13,'currentColor'), title:'Bullet list'},
      {cmd:'insertParagraph',     label:'&para;',       title:'New paragraph'},
    ];
    tbBtns.forEach(function(b) {
      html += '<button type="button" data-cmd="'+b.cmd+'" title="'+b.title+'" style="padding:5px 9px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--ink);cursor:pointer;font-size:11px">'+b.label+'</button>';
    });
    html += '<button type="button" id="mk-lb-clear" class="btn-ic" title="Clear formatting" style="padding:5px 9px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--ghost);cursor:pointer;font-size:11px">'+lucideSVG('eraser',13,'currentColor')+'Clear</button>';
    html += '</div>';
    html += '<div id="mk-lb-body" contenteditable="true" style="min-height:90px;padding:10px 12px;background:var(--bg);border:1px solid var(--border2);border-radius:6px;color:var(--ink);font-size:13px;line-height:1.6;outline:none;transition:border-color .18s" placeholder="Body text...">' + (lb.body||'<p>Add your description here.</p>') + '</div>';
    html += '</div>';
    // Layout-specific fields
    if(lbLy === 'full' || lbLy === 'iframe-text') {
      html += '<div class="f"><label class="fl">Embed URL</label>';
      html += '<input type="text" id="mk-lb-embed" value="'+h(lb.embedUrl||'')+'" placeholder="https://view.genial.ly/..."/></div>';
      if(lbLy==='full') html += '<div class="nt">Fills 80% of map column. Genial.ly, Google Slides, YouTube etc.</div>';
    }
    if(lbLy === 'image-text') {
      html += '<div class="f"><label class="fl">Image URL</label>';
      html += '<input type="text" id="mk-lb-img" value="'+h(lb.img||'')+'" placeholder="https://..."/>' + imageUploadRowHTML('mk-lb-img') + '</div>';
      html += '<div class="f"><label class="fl">Image caption (optional)</label>';
      html += '<input type="text" id="mk-lb-imgcap" value="'+h(lb.imgCaption||'')+'" placeholder="Caption"/></div>';
      html += '<div class="nt">Image is clickable to expand fullscreen.</div>';
    }
    html += '<div class="nt" style="margin-top:10px">Clicking the marker opens this lightbox over the map area.</div>';
  } else {
    html += '<div class="nt" style="opacity:.6">Enable to add an image and rich text shown when the marker is clicked. Choose from 3 layouts.</div>';
  }
  html += '</div>';

  // ── INSERT HTML INTO DOM FIRST ──
  setHTML('rpc', html);

  // ── NOW bind events (DOM exists) ──

  // Bind icon text input
  bindInput('mk-icon', function(v) {
    P.markers[i].icon = v;
    var prev = el('mk-icon-preview');
    if(prev) {
      if(v && v.indexOf('data:') === 0) {
        prev.innerHTML = '<img src="'+v+'" width="20" height="20" style="display:block"/>';
      } else if(isLucide(v)) {
        prev.innerHTML = lucideSVG(v,20,'rgba(255,255,255,.9)');
      } else { prev.textContent = v||' '; }
    }
    var grid = el('mk-icon-grid');
    if(grid) grid.querySelectorAll('.icon-btn').forEach(function(b){
      var isSel = b.dataset.ico===v;
      b.style.background = isSel ? 'var(--accent)' : 'var(--mid)';
      b.style.borderColor = isSel ? 'var(--accent)' : 'var(--border2)';
      b.classList.toggle('on', isSel);
      if(isLucide(b.dataset.ico)) {
        b.innerHTML = lucideSVG(b.dataset.ico, 15, isSel ? '#fff' : 'var(--ghost)');
      }
    });
  });
  // Icon upload (custom SVG)
  var mkIconUpload = el('mk-icon-upload');
  if(mkIconUpload) mkIconUpload.addEventListener('change', function() {
    var file = this.files[0];
    var status = el('mk-icon-upload-status');
    if(!file) return;
    if(!/\.svg$/i.test(file.name) && file.type !== 'image/svg+xml') {
      if(status) status.textContent = 'Please choose an SVG file.';
      return;
    }
    if(file.size > 100*1024) {
      if(status) status.textContent = 'SVG is too large (max 100KB).';
      return;
    }
    var reader = new FileReader();
    reader.onload = function(ev) {
      var text = ev.target.result;
      if(text.indexOf('<svg') === -1) {
        if(status) status.textContent = 'That file doesn\'t look like a valid SVG.';
        return;
      }
      var dataUri = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(text)));
      P.markers[i].icon = dataUri;
      var inp = el('mk-icon'); if(inp) inp.value = '';
      var prev = el('mk-icon-preview');
      if(prev) prev.innerHTML = '<img src="'+dataUri+'" width="20" height="20" style="display:block"/>';
      var iconGrid = el('mk-icon-grid');
      if(iconGrid) iconGrid.querySelectorAll('.icon-btn').forEach(function(b){
        b.classList.remove('on'); b.style.background='var(--mid)'; b.style.borderColor='var(--border2)';
      });
      if(status) status.textContent = 'Custom icon uploaded';
      markDirty(); renderMarkers(); refreshMK();
    };
    reader.readAsText(file);
  });
  // Icon grid click
  var grid = el('mk-icon-grid');
  if(grid) grid.addEventListener('click', function(e) {
    var btn = e.target.closest('.icon-btn');
    if(!btn) return;
    var ico = btn.dataset.ico;
    P.markers[i].icon = ico;
    var inp = el('mk-icon'); if(inp) inp.value = ico;
    var prev = el('mk-icon-preview');
    if(prev) {
      if(isLucide(ico)) {
        prev.innerHTML = lucideSVG(ico,20,'rgba(255,255,255,.9)');
      } else { prev.textContent = ico||' '; }
    }
    grid.querySelectorAll('.icon-btn').forEach(function(b){
      var isSel = b.dataset.ico===ico;
      b.style.background = isSel ? 'var(--accent)' : 'var(--mid)';
      b.style.borderColor = isSel ? 'var(--accent)' : 'var(--border2)';
      b.classList.toggle('on', isSel);
      if(isLucide(b.dataset.ico)) {
        b.innerHTML = lucideSVG(b.dataset.ico, 15, isSel ? '#fff' : 'var(--ghost)');
      }
    });
  });
  // Other marker bindings
  bindInput('mk-name', function(v) { P.markers[i].name=v; renderMarkers(); refreshMK(); });
  bindGroupSelect('mk-group', 'markerGroups', P.markers[i], function(){ renderMarkers(); renderMarkerEditor(i); });
  bindTA('mk-desc', function(v) { P.markers[i].desc=v; });
  var cp = el('mk-col-p'), ct = el('mk-col-t');
  if(cp) cp.addEventListener('input', function() { P.markers[i].color=this.value; if(ct)ct.value=this.value; markDirty(); renderMarkers(); refreshMK(); });
  if(ct) ct.addEventListener('input', function() { P.markers[i].color=this.value; if(cp)cp.value=this.value; markDirty(); renderMarkers(); refreshMK(); });
  // Colour preset dots
  document.querySelectorAll('[data-col]').forEach(function(dot) {
    dot.addEventListener('click', function() {
      var col = this.dataset.col;
      P.markers[i].color = col;
      if(cp) cp.value = col;
      if(ct) ct.value = col;
      markDirty(); renderMarkers(); refreshMK();
      renderMarkerEditor(i); // re-render to update selected state
    });
  });
  bindInputNum('mk-lng', function(v) { P.markers[i].coords[0]=v; refreshMK(); });
  bindInputNum('mk-lat', function(v) { P.markers[i].coords[1]=v; refreshMK(); });
  // Scene visibility toggles
  P.scenes.forEach(function(sc, si) {
    var tg = el('mk-sc-'+si);
    if(!tg) return;
    tg.addEventListener('click', function() {
      if(!P.markers[i].scenes) P.markers[i].scenes = [];
      var idx2 = P.markers[i].scenes.indexOf(sc.id);
      if(idx2 >= 0) {
        P.markers[i].scenes.splice(idx2, 1);
        tg.classList.remove('on');
      } else {
        P.markers[i].scenes.push(sc.id);
        tg.classList.add('on');
      }
      markDirty(); refreshMK();
    });
  });
  var flyTog=el('mk-fly-tog');
  if(flyTog) flyTog.addEventListener('click',function(){
    P.markers[i].flyCamera=!P.markers[i].flyCamera;
    markDirty(); renderMarkerEditor(i);
  });
  var showDrawerTog=el('mk-showdrawer-tog');
  if(showDrawerTog) showDrawerTog.addEventListener('click',function(){
    P.markers[i].showInDrawer = P.markers[i].showInDrawer===false ? true : false;
    markDirty(); renderMarkerEditor(i);
  });
  bindInput('mk-cam-zoom',function(v){P.markers[i].camZoom=parseFloat(v)||15;markDirty();});
  bindInput('mk-cam-pitch',function(v){P.markers[i].camPitch=parseFloat(v)||0;markDirty();});
  bindInput('mk-cam-bearing',function(v){P.markers[i].camBearing=parseFloat(v)||0;markDirty();});
  var camUse=el('mk-cam-use-view');
  if(camUse) camUse.addEventListener('click',function(){
    if(!pMap) return;
    var z=Math.round(pMap.getZoom()*10)/10;
    var p=Math.round(pMap.getPitch());
    var b=Math.round(pMap.getBearing());
    P.markers[i].camZoom=z; P.markers[i].camPitch=p; P.markers[i].camBearing=b;
    markDirty(); renderMarkerEditor(i);
  });
  var camPrev=el('mk-cam-preview');
  if(camPrev) camPrev.addEventListener('click',function(){
    if(pMap) pMap.flyTo({zoom:P.markers[i].camZoom||15,pitch:P.markers[i].camPitch||45,bearing:P.markers[i].camBearing||0,duration:800});
  });
  var lbt = el('mk-lb-tg');
  if(lbt) lbt.addEventListener('click', function() {
    if(!P.markers[i].lightbox) P.markers[i].lightbox={enabled:false,layout:'card',heading:'',body:'',img:'',images:[],imgCaption:''};
    P.markers[i].lightbox.enabled = !P.markers[i].lightbox.enabled;
    markDirty(); renderMarkerEditor(i);
  });
  if(lb.enabled) {
    // Layout picker
    document.querySelectorAll('[data-layout]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        P.markers[i].lightbox.layout = this.dataset.layout;
        markDirty(); renderMarkerEditor(i);
      });
    });
    function lbChanged() { markDirty(); }
    bindInput('mk-lb-head',    function(v) { P.markers[i].lightbox.heading=v;    lbChanged(); });
    bindInput('mk-lb-subhead', function(v) { P.markers[i].lightbox.subheading=v; lbChanged(); });
    // Rich text body — contenteditable
    var bodyEl = el('mk-lb-body');
    if(bodyEl) {
      bodyEl.addEventListener('input', function() {
        P.markers[i].lightbox.body = this.innerHTML; lbChanged();
      });
      bodyEl.addEventListener('focus', function() { this.style.borderColor='var(--accent)'; });
      bodyEl.addEventListener('blur',  function() { this.style.borderColor='var(--border2)'; });
    }
    // Toolbar buttons
    var toolbar = el('mk-lb-toolbar');
    if(toolbar) toolbar.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-cmd]');
      if(!btn) return;
      document.execCommand(btn.dataset.cmd, false, null);
      if(bodyEl) { P.markers[i].lightbox.body = bodyEl.innerHTML; markDirty(); }
    });
    var clearBtn = el('mk-lb-clear');
    if(clearBtn) clearBtn.addEventListener('click', function() {
      if(bodyEl) { bodyEl.innerHTML = '<p></p>'; P.markers[i].lightbox.body='<p></p>'; markDirty(); bodyEl.focus(); }
    });
    bindInput('mk-lb-img',    function(v) { P.markers[i].lightbox.img=v;      lbChanged(); });
    bindImageUpload('mk-lb-img', 1600, function(dataUri){ P.markers[i].lightbox.img=dataUri; lbChanged(); });
    bindInput('mk-lb-embed',  function(v) { P.markers[i].lightbox.embedUrl=v; lbChanged(); });
    bindInput('mk-lb-embed',  function(v) { P.markers[i].lightbox.embedUrl=v; lbChanged(); });
    bindInput('mk-lb-imgcap', function(v) { P.markers[i].lightbox.imgCaption=v; markDirty(); });
    var imgsEl = el('mk-lb-imgs');
    if(imgsEl) imgsEl.addEventListener('input', function() {
      P.markers[i].lightbox.images = this.value.split('\n').map(function(s){return s.trim();}).filter(Boolean);
      markDirty();
    });
  }
  // Click-to-place only when button pressed
  var placeBtn = el('mk-place-btn');
  if(placeBtn) placeBtn.addEventListener('click', function() {
    if(!pMap || !pReady) return;
    placeBtn.innerHTML = lucideSVG('crosshair',13,'currentColor')+'Click map to place...';
    placeBtn.style.background = 'var(--accent)';
    pMap.getCanvas().style.cursor = 'crosshair';
    pMap.once('click', function(e) {
      pMap.getCanvas().style.cursor = '';
      placeBtn.innerHTML = lucideSVG('crosshair',13,'currentColor')+'Click map to place';
      placeBtn.style.background = '';
      P.markers[i].coords = [parseFloat(e.lngLat.lng.toFixed(6)), parseFloat(e.lngLat.lat.toFixed(6))];
      var lngEl = el('mk-lng'), latEl = el('mk-lat');
      if(lngEl) lngEl.value = P.markers[i].coords[0];
      if(latEl) latEl.value = P.markers[i].coords[1];
      markDirty(); refreshMK();
    });
  });
}

// ═══════════════════════════════════════════════════
//  RIGHT PANEL — ZONE EDITOR
// ═══════════════════════════════════════════════════
function renderZoneEditor(i) {
  var z = P.zones[i];
  if (!z) { setHTML('rpc','<div class="es">Select a zone to edit</div>'); return; }

  var html = '<div class="rh"><div class="re">Zone</div><div class="rt">'+h(z.name||'Unnamed')+'</div></div>';
  html += '<div class="rs"><div class="st">Details</div>';
  html += fld('Name','zn-name',h(z.name));
  html += '<div class="f"><label class="fl">Group</label><select id="zn-group">'+groupSelectOptions('zoneGroups', z.groupId)+'</select></div>';
  html += fldTA('Popup description','zn-popup',h(z.popup));
  html += '<div class="f"><label class="fl">Colour</label><div class="cr"><input type="color" id="zn-col-p" value="'+h(z.color)+'"/><input type="text" id="zn-col-t" value="'+h(z.color)+'"/></div></div>';
  html += '<div class="f"><label class="fl">Fill opacity <span id="zn-op-v" style="font-family:var(--mono);color:var(--ink)">'+z.opacity+'</span></label>';
  html += '<input type="range" id="zn-op" min="0.05" max="0.5" step="0.05" value="'+z.opacity+'"/></div>';
  html += '<div class="f"><label class="fl">Corner rounding <span id="zn-sm-v" style="font-family:var(--mono);color:var(--ink)">'+(z.smoothRadius||0)+'</span></label>';
