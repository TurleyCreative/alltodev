function sanitizeBody(html) {
  if (!html) return '';
  // Strip full-document tags that break the exported page structure
  return html
    .replace(/<!(DOCTYPE|doctype)[^>]*>/gi, '')
    .replace(/<html[^>]*>/gi, '').replace(/<\/html>/gi, '')
    .replace(/<head[^>]*>[sS]*?<\/head>/gi, '')
    .replace(/<body[^>]*>/gi, '').replace(/<\/body>/gi, '')
    .replace(/<style[^>]*>[sS]*?<\/style>/gi, '')
    .replace(/<script[^>]*>[sS]*?<\/script>/gi, '')
    .trim();
}

