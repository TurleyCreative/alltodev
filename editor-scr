function renderLines() {
  var ul = el('line-list');
  if(!ul) return;
  ul.innerHTML = '';
  if(!(P.lines||[]).length) { ul.innerHTML = '<div class="es">No lines yet. Click + to add.</div>'; return; }
  var groups = grpArr('lineGroups');
  var selRef = {get:function(){return ALN;}, set:function(v){ALN=v;}};
  function afterMove() { renderLines(); refreshLines(); }

  function rowEl(ln, i) {
    var div = mk('div', 'li' + (i===ALN?' on':'')+(ln.groupId?' grp-item':''));
    div.innerHTML =
      '<div style="width:20px;height:4px;border-radius:2px;flex-shrink:0;background:'+h(ln.color||'#ffffff')+';margin-right:8px;margin-top:2px"></div>'+
      '<span class="nm">' + h(ln.name||'Untitled') + '</span>' +
      '<div class="ia">' +
        (i>0 ? '<button class="ib" data-i="'+i+'" data-a="up" title="Move up">'+lucideSVG('arrow-up',12,'currentColor')+'</button>' : '') +
        (i<P.lines.length-1 ? '<button class="ib" data-i="'+i+'" data-a="dn" title="Move down">'+lucideSVG('arrow-down',12,'currentColor')+'</button>' : '') +
        '<button class="ib" data-i="'+i+'" data-a="dup" title="Duplicate">'+lucideSVG('copy',12,'currentColor')+'</button>' +
        '<button class="ib d" data-i="'+i+'" data-a="del" title="Delete">'+lucideSVG('trash-2',12,'currentColor')+'</button>' +
      '</div>';
    div.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-a]');
      if(btn) {
        e.stopPropagation();
        var idx=parseInt(btn.dataset.i), act=btn.dataset.a;
        if(act==='up'){ moveItemInScope('lines', idx, -1, afterMove, selRef); return; }
        if(act==='dn'){ moveItemInScope('lines', idx, 1, afterMove, selRef); return; }
        if(act==='del') { if(confirm('Delete line?')){ P.lines.splice(idx,1); if(ALN>=P.lines.length) ALN=P.lines.length-1; markDirty(); renderLines(); refreshLines(); renderLineEditor(ALN); } }
        if(act==='dup') { var c=JSON.parse(JSON.stringify(P.lines[idx])); c.id='l'+Date.now(); c.name+=' (copy)'; P.lines.splice(idx+1,0,c); markDirty(); renderLines(); refreshLines(); }
        return;
      }
      ALN = i; ensureEditorTab(); renderLines(); renderLineEditor(i); switchTab('ln');
    });
    makeRowDraggable(div, 'lines', i, afterMove);
    return div;
  }

  P.lines.forEach(function(ln, i) { if(!ln.groupId) ul.appendChild(rowEl(ln, i)); });
  groups.forEach(function(g, gi) {
    ul.appendChild(renderGroupHeader(g, gi, groups, 'lines', afterMove));
    if(!g.collapsed) P.lines.forEach(function(ln, i) { if(ln.groupId===g.id) ul.appendChild(rowEl(ln, i)); });
  });
  makeListContainerDroppable(ul, 'lines', afterMove);
}

