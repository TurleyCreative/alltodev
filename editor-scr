<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Consultation Map Builder</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css" rel="stylesheet"/>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>
<link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.4.3/mapbox-gl-draw.css"/>
<script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.4.3/mapbox-gl-draw.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0d0c0b;--surface:#141312;--panel:#1a1917;--border:#2a2825;
  --border2:#333230;--ink:#f0ece4;--ghost:#9a948d;--ink2:rgba(255,255,255,.7);--mid:#3a3835;
  --accent:#207ab6;--accent2:#4a9b7f;--blue:#4a7bc8;
  --nt-bg:rgba(74,123,200,.1);--nt-border:rgba(74,123,200,.2);--nt-ink:#8ab0e0;
  --nt-w-bg:rgba(200,130,10,.1);--nt-w-border:rgba(200,130,10,.2);--nt-w-ink:#d4a84a;
  --badge-ink:var(--accent2);
  --sans:"DM Sans",system-ui,-apple-system,sans-serif;
  --mono:"Consolas","Courier New",monospace;
  --ease:cubic-bezier(.4,0,.2,1);
}
:root[data-theme="light"]{
  --bg:#f7f5f1;--surface:#ffffff;--panel:#fbfaf7;--border:#e4e0d8;
  --border2:#d2ccc0;--ink:#201e1a;--ghost:#5c574f;--ink2:rgba(0,0,0,.65);--mid:#e8e3d9;
  --nt-bg:rgba(34,85,170,.08);--nt-border:rgba(34,85,170,.25);--nt-ink:#2255aa;
  --nt-w-bg:rgba(180,110,10,.1);--nt-w-border:rgba(180,110,10,.3);--nt-w-ink:#8a5a12;
  --badge-ink:#2f6b52;
}
html,body{height:100%;overflow:hidden;font-family:var(--sans);background:var(--bg);color:var(--ink);transition:background .2s var(--ease),color .2s var(--ease)}
#app{display:grid;grid-template-columns:300px 1fr 360px;grid-template-rows:52px 1fr;height:100vh;overflow:hidden}
#topbar{grid-column:1/-1;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 16px}
.tb-brand{font-size:13px;font-weight:500;letter-spacing:.01em;display:flex;align-items:center;gap:10px}
.tb-dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
.tb-tabs{display:flex;margin-left:24px}
.tb-tab{padding:0 18px;height:52px;display:flex;align-items:center;font-size:12px;font-weight:500;color:var(--ghost);cursor:pointer;border-bottom:2px solid transparent;transition:all .18s}
.tb-tab.on{color:var(--ink);border-bottom-color:var(--accent)}
.tb-tab:hover{color:var(--ink)}
.tb-actions{display:flex;gap:8px;align-items:center}
.btn{padding:8px 16px;border-radius:8px;font-family:var(--sans);font-size:12px;font-weight:500;cursor:pointer;border:none;transition:all .18s}
.btn-g{background:transparent;color:var(--ghost);border:1px solid var(--border2)}
.btn-g:hover{color:var(--ink);border-color:var(--mid)}
.btn-dl{background:var(--accent);color:#fff;border:1px solid var(--accent)}
.btn-dl:hover{opacity:.88}
.btn-ic{display:inline-flex;align-items:center;gap:6px}
.btn-ic svg{flex-shrink:0}
.ico-h{display:inline-flex;align-items:center;gap:6px;vertical-align:middle}
.btn-a{background:var(--accent);color:#fff}
.btn-a:hover{background:#1a6393}
.badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:500;background:rgba(74,155,127,.15);color:var(--badge-ink)}
.bdot{width:6px;height:6px;border-radius:50%;background:var(--accent2);animation:bdp 2s infinite}
@keyframes bdp{0%,100%{opacity:1}50%{opacity:.3}}
*::-webkit-scrollbar-button{display:none!important;width:0!important;height:0!important}
*::-webkit-scrollbar-button:single-button,*::-webkit-scrollbar-button:start,*::-webkit-scrollbar-button:end,*::-webkit-scrollbar-button:increment,*::-webkit-scrollbar-button:decrement,*::-webkit-scrollbar-button:vertical:start:decrement,*::-webkit-scrollbar-button:vertical:end:increment,*::-webkit-scrollbar-button:horizontal:start:decrement,*::-webkit-scrollbar-button:horizontal:end:increment{display:none!important;width:0!important;height:0!important}
#lp{background:var(--panel);border-right:1px solid var(--border);overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border) transparent;display:flex;flex-direction:column}
#lp::-webkit-scrollbar{width:4px}#lp::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
.tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0}
.tab{flex:1;padding:10px 8px;font-size:11px;letter-spacing:.01em;font-weight:500;color:var(--ghost);cursor:pointer;text-align:center;border-bottom:2px solid transparent;transition:all .18s}
.tab.on{color:var(--ink);border-bottom-color:var(--accent)}
.tc{display:none}.tc.on{display:block}
.ps{padding:18px;border-bottom:1px solid var(--border)}
.st{font-size:12px;letter-spacing:.01em;color:var(--ink2,rgba(255,255,255,.7));font-weight:500;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.ab{width:22px;height:22px;border-radius:7px;background:var(--mid);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;color:var(--ink);transition:background .18s;border:none}
.ab:hover{background:var(--accent);color:#fff}
.f{margin-bottom:12px}.f:last-child{margin-bottom:0}
.fl{font-size:11px;letter-spacing:.01em;color:var(--ghost);margin-bottom:5px;display:block;font-weight:500}
.f input,.f textarea,.f select{width:100%;padding:8px 11px;background:var(--bg);border:1px solid var(--border2);border-radius:7px;color:var(--ink);font-family:var(--sans);font-size:13px;outline:none;transition:border-color .18s}
.f input:focus,.f textarea:focus{border-color:var(--accent)}
.f textarea{resize:vertical;min-height:66px;line-height:1.5}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cr{display:flex;align-items:center;gap:8px}
.cr input[type=color]{width:32px;height:32px;padding:2px;cursor:pointer;border-radius:7px;flex-shrink:0;border:1px solid var(--border2);background:var(--bg)}
.si{padding:10px 12px;border-radius:9px;border:1px solid var(--border);cursor:pointer;background:var(--bg);display:flex;align-items:center;gap:8px;transition:all .18s;margin-bottom:6px}
.si:hover{border-color:var(--border2)}.si.on{border-color:var(--accent);background:rgba(32,122,182,.06)}
.li{padding:10px 12px;border-radius:9px;border:1px solid var(--border);cursor:pointer;background:var(--bg);display:flex;align-items:center;gap:8px;transition:all .18s;margin-bottom:6px}
.li:hover{border-color:var(--border2)}.li.on{border-color:var(--accent2)}
.in{font-size:11px;color:var(--ghost);font-family:var(--mono);min-width:18px}
.nm{font-size:13px;font-weight:500;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ia{display:flex;gap:3px;opacity:0;transition:opacity .18s}
.si:hover .ia,.li:hover .ia{opacity:1}
.ib{width:22px;height:22px;border-radius:7px;background:var(--mid);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--ghost);transition:all .18s}
.ib:hover{background:var(--border2);color:var(--ink)}.ib.d:hover{background:#c0392b;color:#fff}
.icon-preview{width:32px;height:32px;border-radius:50%;background:var(--ghost);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.id{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.grp-hdr{padding:8px 10px 8px 6px;border-radius:9px;display:flex;align-items:center;gap:6px;cursor:pointer;margin-bottom:4px;margin-top:10px;transition:background .15s}
.grp-hdr:first-child{margin-top:0}
.grp-hdr:hover{background:var(--bg)}
.grp-chev{width:20px;height:20px;border-radius:6px;background:transparent;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ghost);flex-shrink:0}
.grp-chev:hover{background:var(--border2);color:var(--ink)}
.grp-name{font-size:11px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--ghost);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.grp-name:hover{color:var(--ink)}
.grp-count{font-size:10px;color:var(--ghost);font-family:var(--mono);flex-shrink:0}
.grp-hdr .ia{opacity:0}
.grp-hdr:hover .ia{opacity:1}
.grp-item{margin-left:14px}
.li.dragging{opacity:.4}
.li.drag-over{outline:2px dashed var(--accent2);outline-offset:-2px}
.grp-hdr.drag-over{outline:2px dashed var(--accent2);outline-offset:-2px;background:var(--bg)}
.lt{display:flex;flex-direction:column;gap:6px}
.lr{display:flex;align-items:center;justify-content:space-between;padding:7px 11px;border-radius:8px;background:var(--bg);border:1px solid var(--border)}
.ll{font-size:12px;font-weight:500;color:var(--ghost)}
.tg{width:30px;height:16px;border-radius:8px;background:var(--mid);cursor:pointer;position:relative;transition:background .2s;border:none;flex-shrink:0}
.tg::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#fff;transition:transform .2s}
.tg.on{background:var(--accent)}.tg.on::after{transform:translateX(14px)}
input[type=range]{flex:1;height:17px;padding:0;background:transparent;border:none;-webkit-appearance:none;-moz-appearance:none;outline:none;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:3px;border-radius:2px;background:linear-gradient(to right,var(--accent) 0%,var(--accent) var(--pct,50%),var(--border2) var(--pct,50%),var(--border2) 100%)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:17px;height:17px;border-radius:50%;background:var(--accent);border:none;box-shadow:0 1px 4px rgba(0,0,0,.4);cursor:pointer;transition:transform .12s ease;margin-top:-7px}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.12)}
input[type=range]::-webkit-slider-thumb:active{transform:scale(1.05)}
input[type=range]::-moz-range-track{height:3px;border-radius:2px;background:var(--border2)}
input[type=range]::-moz-range-progress{height:3px;border-radius:2px;background:var(--accent)}
input[type=range]::-moz-range-thumb{width:17px;height:17px;border-radius:50%;background:var(--accent);border:none;box-shadow:0 1px 4px rgba(0,0,0,.4);cursor:pointer;transition:transform .12s ease}
input[type=range]::-moz-range-thumb:hover{transform:scale(1.12)}
input[type=range]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.rng-row{display:flex;align-items:center;gap:10px}
.f input.rng-val{width:60px;flex-shrink:0;text-align:center;padding:6px 8px;font-family:var(--mono);font-size:12px}
.eg-handle{position:absolute;width:12px;height:12px;margin-left:-6px;margin-top:-6px;border-radius:50%;background:var(--surface);border:2px solid var(--accent);cursor:grab;touch-action:none}
.eg-handle:active{cursor:grabbing}
.eg-handle:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.rv{font-family:var(--mono);font-size:11px;color:var(--ink);min-width:30px;text-align:right}
.nt{padding:9px 13px;border-radius:9px;background:var(--nt-bg);border:1px solid var(--nt-border);font-size:12px;color:var(--nt-ink);font-family:var(--mono);line-height:1.5;margin-bottom:10px}
.nt a{color:inherit}
.lr+.nt{margin-top:10px}
.nt.w{background:var(--nt-w-bg);border-color:var(--nt-w-border);color:var(--nt-w-ink)}
#mp{position:relative;overflow:hidden;background:#111}
#pm{width:100%;height:100%}
#pnt{position:absolute;inset:0;background:var(--surface);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:40px}
#pnt h3{font-size:16px;font-weight:500}
#pnt p{font-size:12px;color:var(--ghost);max-width:26ch;line-height:1.6;font-family:var(--mono)}
#pl{position:absolute;bottom:12px;left:12px;background:rgba(13,12,11,.85);backdrop-filter:blur(8px);padding:7px 12px;border-radius:7px;font-size:11px;letter-spacing:.02em;color:var(--ghost);pointer-events:none;border-top:2px solid var(--accent)}
#rp{background:var(--panel);border-left:1px solid var(--border);overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border) transparent}
#rp::-webkit-scrollbar{width:4px}#rp::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
.rh{padding:18px 18px 14px;border-bottom:1px solid var(--border)}
.re{font-size:11px;letter-spacing:.02em;color:var(--ghost);margin-bottom:3px}
.rt{font-size:16px;font-weight:500}
.rs{padding:18px;border-bottom:1px solid var(--border)}
.rs:last-child{border-bottom:none}
.rs.collapsed>*:not(.st-primary){display:none}
.rs.collapsed>.st-primary{margin-bottom:0}
.st-label{flex:1;display:flex;align-items:center;gap:6px}
.st-chev{background:none;border:none;padding:2px;margin:0;flex-shrink:0;display:flex;align-items:center;color:var(--ghost);cursor:pointer;transition:transform .15s ease}
.st-chev svg{display:block}
.rs.collapsed .st-chev{transform:rotate(-90deg)}
.es{padding:28px 16px;text-align:center;font-size:12px;color:var(--ghost);font-family:var(--mono);line-height:1.7}
#em{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center}
#em.on{display:flex}
.mb{background:var(--surface);border:1px solid var(--border2);border-radius:14px;width:min(500px,calc(100vw - 40px));box-shadow:0 20px 60px rgba(0,0,0,.5)}
.mh{padding:22px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.mh h3{font-size:15px;font-weight:500}
.mx{width:28px;height:28px;border-radius:8px;background:var(--mid);border:none;cursor:pointer;color:var(--ghost);font-size:14px;display:flex;align-items:center;justify-content:center}
.mx:hover{color:var(--ink)}
.md{padding:20px 24px;max-height:70vh;overflow-y:auto}
.mo{padding:14px 17px;border-radius:11px;border:1px solid var(--border);margin-bottom:8px;cursor:pointer;transition:all .18s}
.mo:hover{border-color:var(--accent);background:rgba(32,122,182,.05)}
.mo h4{font-size:13px;font-weight:500;margin-bottom:3px;display:flex;align-items:center;gap:6px}
.mo p{font-size:12px;color:var(--ghost);line-height:1.5}
.a11y-item{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--border)}
.a11y-item:last-child{border-bottom:none}
.a11y-badge{flex-shrink:0;font-size:10px;font-weight:500;letter-spacing:.02em;padding:3px 8px;border-radius:6px;white-space:nowrap;font-family:var(--sans)}
.a11y-pass .a11y-badge{background:rgba(74,155,127,.15);color:var(--accent2)}
.a11y-warn .a11y-badge{background:rgba(212,130,10,.15);color:#d4820a}
.a11y-fail .a11y-badge{background:rgba(192,57,43,.15);color:#e2564a}
.a11y-manual .a11y-badge{background:var(--mid);color:var(--ghost)}
.a11y-item-label{font-size:13px;font-weight:500;line-height:1.4}
.a11y-item-detail{font-size:11px;color:var(--ghost);line-height:1.5;margin-top:2px}
.sr{display:flex;gap:7px;margin-top:8px}
.sr input{flex:1;padding:8px 11px;background:var(--bg);border:1px solid var(--border2);border-radius:7px;color:var(--ghost);font-family:var(--sans);font-size:12px;outline:none}
/* Consistent keyboard focus ring across custom controls */
.btn:focus-visible,.tab:focus-visible,.tb-tab:focus-visible,.tg:focus-visible,
.ab:focus-visible,.ib:focus-visible,.si:focus-visible,.li:focus-visible,
.mx:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,
[contenteditable]:focus-visible{
  outline:2px solid var(--accent);outline-offset:2px;
}
.f input:focus-visible,.f textarea:focus-visible,.f select:focus-visible{outline-offset:1px}
/* Theme toggle */
#btn-theme-toggle{width:32px;height:32px;padding:0;display:flex;align-items:center;justify-content:center;font-size:15px}
#btn-theme-toggle .tt-icon-wrap{position:relative;width:18px;height:18px}
#btn-theme-toggle .tt-icon-wrap svg{position:absolute;inset:0;opacity:0;transition:opacity .3s ease,transform .3s ease;transform:scale(.7) rotate(-20deg)}
:root[data-theme="light"] #btn-theme-toggle .tt-sun{opacity:1;transform:scale(1) rotate(0deg)}
:root[data-theme="light"] #btn-theme-toggle:hover .tt-sun{opacity:0;transform:scale(.7) rotate(20deg)}
:root[data-theme="light"] #btn-theme-toggle:hover .tt-sunset{opacity:1;transform:scale(1) rotate(0deg)}
:root[data-theme="dark"] #btn-theme-toggle .tt-moon{opacity:1;transform:scale(1) rotate(0deg)}
:root[data-theme="dark"] #btn-theme-toggle:hover .tt-moon{opacity:0;transform:scale(.7) rotate(20deg)}
:root[data-theme="dark"] #btn-theme-toggle:hover .tt-sunrise{opacity:1;transform:scale(1) rotate(0deg)}
@keyframes tt-spin{
  0%{transform:rotate(0deg) scale(1)}
  50%{transform:rotate(180deg) scale(.72);opacity:.55}
  100%{transform:rotate(360deg) scale(1);opacity:1}
}
#btn-theme-toggle .tt-icon-wrap.spin{animation:tt-spin .5s cubic-bezier(.4,0,.2,1)}
/* Unsaved-changes indicator (dot + text, not color-only) */
#dirty-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:bdp 1.4s infinite;flex-shrink:0}
.tb-status{font-size:10px;font-family:var(--mono);color:var(--ghost);display:flex;align-items:center;gap:6px}
</style>
<style>
/* Context marker HTML markers — used in both editor preview and generated output */
.ctx-marker{
  width:34px;height:34px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  border:2.5px solid rgba(255,255,255,.7);
  box-shadow:0 2px 10px rgba(0,0,0,.35);
  cursor:pointer;transition:transform .15s;
  position:relative;
}
.ctx-marker:hover{transform:scale(1.15)}
.ctx-marker img{width:16px;height:16px;filter:invert(1);pointer-events:none}
.ctx-marker .ctx-emoji{font-size:15px;line-height:1;pointer-events:none}
.ctx-marker-stem{width:2px;height:8px;margin:0 auto;opacity:.6}
.ctx-marker-wrap{display:flex;flex-direction:column;align-items:center;transform:translateY(-100%)}
</style>
</head>
<body>
<div id="app">
<div id="topbar">
  <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
    <div class="tb-brand" style="gap:10px">
      <img src="data:image/svg+xml;base64," id="topbar-logo" alt="allto*" style="height:22px;width:auto;display:block;flex-shrink:0"/>
    </div>
    <div class="tb-tabs">
      <div class="tb-tab on" id="tt-editor" onclick="switchMain('editor')">Editor</div>
      <div class="tb-tab" id="tt-settings" onclick="switchMain('settings')">Settings</div>
      <div class="tb-tab" id="tt-seo" onclick="switchMain('seo')">SEO</div>
      <div class="tb-tab" id="tt-about" onclick="openAboutModal()">About</div>
    </div>
  </div>
  <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
