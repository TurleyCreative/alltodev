  ul.innerHTML = '';
  var groups = grpArr('markerGroups');
  var selRef = {get:function(){return AM;}, set:function(v){AM=v;}};

  function rowEl(m, i) {
    var div = mk('div', 'li'+(AM===i?' on':'')+(m.groupId?' grp-item':''));
    div.innerHTML =
      '<div class="id" style="background:'+h(m.color)+'"></div>' +
      '<span class="nm">'+h(m.name||'Unnamed')+'</span>' +
      '<div class="ia">'+
        (i>0?'<button class="ib" data-a="up" data-i="'+i+'" title="Move up">'+lucideSVG('arrow-up',12,'currentColor')+'</button>':'')+
        (i<P.markers.length-1?'<button class="ib" data-a="dn" data-i="'+i+'" title="Move down">'+lucideSVG('arrow-down',12,'currentColor')+'</button>':'')+
        '<button class="ib d" data-a="del" data-i="'+i+'">'+lucideSVG('trash-2',12,'currentColor')+'</button>'+
      '</div>';
    div.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-a]');
      if (btn && e.target.closest('.ia')) {
        e.stopPropagation();
        var ii = parseInt(btn.dataset.i), act = btn.dataset.a;
        if(act==='del') { delMarker(ii); }
        else if(act==='up') { moveItemInScope('markers', ii, -1, refreshMK, selRef); }
        else if(act==='dn') { moveItemInScope('markers', ii, 1, refreshMK, selRef); }
        return;
      }
      selMarker(i);
    });
    makeRowDraggable(div, 'markers', i, refreshMK);
    return div;
  }

  P.markers.forEach(function(m, i) { if(!m.groupId) ul.appendChild(rowEl(m, i)); });
  groups.forEach(function(g, gi) {
    ul.appendChild(renderGroupHeader(g, gi, groups, 'markers', refreshMK));
    if(!g.collapsed) P.markers.forEach(function(m, i) { if(m.groupId===g.id) ul.appendChild(rowEl(m, i)); });
  });
  makeListContainerDroppable(ul, 'markers', refreshMK);
}
