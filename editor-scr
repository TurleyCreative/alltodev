    scBodyEl.addEventListener('focus', function() { this.style.borderColor='var(--accent)'; try{document.execCommand('defaultParagraphSeparator', false, 'p');}catch(e){} });
    scBodyEl.addEventListener('blur',  function() { this.style.borderColor='var(--border2)'; });
  }
  var scToolbar = el('sc-body-toolbar');
  if(scToolbar) {
    scToolbar.addEventListener('mousedown', function(e) {
