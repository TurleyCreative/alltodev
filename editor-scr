      if(scBodyEl) scBodyEl.focus();
      var cmd = btn.dataset.scCmd;
      if(cmd.indexOf('formatBlock:') === 0) {
        document.execCommand('formatBlock', false, cmd.split(':')[1]);
      } else {
        document.execCommand(cmd, false, null);
      }
      if(scBodyEl) { P.scenes[AS].body = scBodyEl.innerHTML; markDirty(); }
    });
  }
  var scClear = el('sc-body-clear');
  if(scClear) scClear.addEventListener('click', function() {
    if(scBodyEl) { scBodyEl.innerHTML = ''; P.scenes[AS].body = ''; markDirty(); scBodyEl.focus(); }
  });
  var scHtmlToggle = el('sc-body-html-toggle');
  var scRaw = el('sc-body-raw');
  var scApply = el('sc-body-html-apply');
  var scHtmlMode = false;
  if(scHtmlToggle) scHtmlToggle.addEventListener('click', function() {
    scHtmlMode = !scHtmlMode;
    if(scHtmlMode) {
      scRaw.value = P.scenes[AS].body || '';
      scRaw.style.display = 'block';
      scApply.style.display = 'inline-block';
      scBodyEl.style.display = 'none';
      scBodyEl.contentEditable = 'true';
      scHtmlToggle.style.color = 'var(--accent)';
      scHtmlToggle.style.borderColor = 'var(--accent)';
      scHtmlToggle.title = 'Exit HTML mode without applying';
      setTimeout(function(){ scRaw.focus(); scRaw.select(); }, 50);
    } else {
      scRaw.style.display = 'none';
      scApply.style.display = 'none';
      scBodyEl.style.display = 'block';
      scHtmlToggle.style.color = '';
      scHtmlToggle.style.borderColor = '';
    }
  });
  if(scApply) scApply.addEventListener('click', function() {
    var raw = scRaw.value;
    P.scenes[AS].body = raw;
    markDirty();
    // Show a safe preview in the editor — don't render arbitrary HTML into the UI
    var lineCount = raw.split('\n').length;
    var preview = raw.replace(/</g,'&lt;').replace(/>/g,'&gt;');
    if(scBodyEl) scBodyEl.innerHTML = '<div style="font-family:var(--mono);font-size:10px;color:var(--ghost);line-height:1.5;white-space:pre-wrap;pointer-events:none">'+preview+'</div>';
    scHtmlMode = false;
    scRaw.style.display = 'none';
    scApply.style.display = 'none';
    scBodyEl.style.display = 'block';
    scBodyEl.contentEditable = 'false';
    scHtmlToggle.style.color = 'var(--accent2)';
    scHtmlToggle.title = 'HTML mode active — click to edit';
  });
  // Also: when toggling back into HTML mode, restore contentEditable
  
  bindRng('sc-zoom', function(v) { P.scenes[AS].camera.zoom=v; if(pMap)pMap.setZoom(v); });
  bindRng('sc-pitch', function(v) { P.scenes[AS].camera.pitch=v; if(pMap)pMap.setPitch(v); });
  bindRng('sc-bearing', function(v) { P.scenes[AS].camera.bearing=v; if(pMap)pMap.setBearing(v); });
  bindTg('sc-l-redline', function(v) { P.scenes[AS].layers.redline=v; updatePreview(); });
  bindTg('sc-l-context', function(v) { P.scenes[AS].layers.context=v; updatePreview(); });
  bindTg('sc-l-constraints', function(v) { P.scenes[AS].layers.constraints=v; updatePreview(); });
  bindTg('sc-l-custom-bld', function(v){ P.scenes[AS].layers.buildings=v; markDirty(); updatePreview(); });
  bindTg('sc-l-buildings3d', function(v) { P.scenes[AS].layers.buildings3d=v; updatePreview(); });
  bindTg('sc-l-orbit', function(v) { if(!P.scenes[AS].layers) P.scenes[AS].layers={}; P.scenes[AS].layers.orbit=v; updatePreview(); });


  var pcb = el('btn-prev-cam');
  if (pcb) pcb.addEventListener('click', function() {
    if (!pMap) return;
    var c = P.scenes[AS].camera;
    pMap.flyTo({center:P.siteCentre,zoom:c.zoom,pitch:c.pitch,bearing:c.bearing,duration:900});
  });
}



