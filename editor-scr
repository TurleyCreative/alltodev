          if(P.mapboxToken && P.mapboxToken.startsWith('pk.')) {
            el('pnt').style.display = 'none';
            initPreview();
          }
        }, 100);
      } catch(e) { alert('Could not read file: ' + e.message); }
    };
    reader.readAsText(file);
    this.value = '';
  });

  var btnExJ = el('btn-export-json');
  if(btnExJ) btnExJ.addEventListener('click', function() {
    var blob = new Blob([JSON.stringify(P, null, 2)], {type:'application/json'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = (P.name||'consultation').toLowerCase().replace(/\s+/g,'-') + '.json';
    a.click(); URL.revokeObjectURL(url);
  });

  // JSON Import
  var impF = el('import-json-file');
  if(impF) impF.addEventListener('change', function() {
    var file = this.files[0]; if(!file) return;
    var reader = new FileReader();
    reader.onload = function(ev) {
      try {
        var data = JSON.parse(ev.target.result);
        if(!data.scenes || !Array.isArray(data.scenes)) { alert('Invalid project JSON.'); return; }
        P = data;
        AS = 0; AM = -1; AZ = -1; AOV = -1;
        markDirty(); renderAll();
        if(pMap && pReady) { try{pMap.remove();}catch(e){} pMap=null; pReady=false; pCtxMarkers=[]; }
        tryInitPreview();
        el('em').classList.remove('on');
      } catch(err) { alert('Could not parse JSON: ' + err.message); }
    };
    reader.readAsText(file);
    this.value = '';
  });
