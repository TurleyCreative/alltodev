function compressImageFile(file, maxDim, cb) {
  if(!file.type || file.type.indexOf('image/') !== 0) { cb(new Error('not an image')); return; }
  if(file.size > 20*1024*1024) { cb(new Error('too large')); return; }
  var keepPng = file.type === 'image/png';
  var url = URL.createObjectURL(file);
  var img = new Image();
  img.onload = function() {
    var w = img.naturalWidth, h = img.naturalHeight;
    var scale = Math.min(1, maxDim / Math.max(w, h));
    var cw = Math.max(1, Math.round(w * scale)), ch = Math.max(1, Math.round(h * scale));
    var canvas = document.createElement('canvas');
    canvas.width = cw; canvas.height = ch;
    var ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, cw, ch);
    URL.revokeObjectURL(url);
    try {
      var dataUri = keepPng ? canvas.toDataURL('image/png') : canvas.toDataURL('image/jpeg', 0.92);
      cb(null, dataUri);
    } catch(e) { cb(e); }
  };
  img.onerror = function() { URL.revokeObjectURL(url); cb(new Error('could not read image')); };
  img.src = url;
}
function bindImageUpload(fieldId, maxDim, setter) {
  var input = el(fieldId+'-upload');
  if(!input) return;
  input.addEventListener('change', function() {
    var file = this.files[0];
    var status = el(fieldId+'-upload-status');
    if(!file) return;
    if(file.type.indexOf('image/') !== 0) {
      if(status) status.textContent = 'Please choose an image file.';
      return;
    }
    function finish(dataUri) {
      var urlInput = el(fieldId);
      if(urlInput) urlInput.value = '';
      setter(dataUri);
      var kb = Math.max(1, Math.round(dataUri.length * 0.75 / 1024));
      if(status) status.textContent = 'Image uploaded (' + kb + ' KB)';
      markDirty();
    }
    // SVG is vector — preserve as-is rather than rasterizing through canvas
    if(file.type === 'image/svg+xml') {
      var reader = new FileReader();
      reader.onload = function(ev) {
        var text = ev.target.result;
        if(text.indexOf('<svg') === -1) { if(status) status.textContent = 'That file doesn\'t look like a valid SVG.'; return; }
        finish('data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(text))));
      };
      reader.readAsText(file);
      return;
    }
    if(status) status.textContent = 'Compressing…';
    compressImageFile(file, maxDim, function(err, dataUri) {
      if(err) { if(status) status.textContent = 'Could not read that image.'; return; }
      finish(dataUri);
    });
  });
}


