  if(pMap.getSource('p-bld')) pMap.getSource('p-bld').setData(bldGJ());
  // Toggle style-native building extrusion layers in preview
  var _pShowBld = L.buildings3d||L.orbit;
  var _pOp = _pShowBld ? 0.85 : 0;
  // Mapbox Standard style
  try{ pMap.setConfigProperty('basemap','show3dObjects',_pShowBld); }catch(e){}
  try{ pMap.setConfigProperty('basemap','showBuildings',_pShowBld); }catch(e){}
  // Classic styles
  try{pMap.getStyle().layers.forEach(function(l){
    if(l.type==='fill-extrusion'&&l.id!=='p-zn-ex'&&l.id!=='p-zn-3d') pMap.setPaintProperty(l.id,'fill-extrusion-opacity',_pOp);
  });}catch(e){}
  if(!_pShowBld){
    setTimeout(function(){
      try{pMap.getStyle().layers.forEach(function(l){
        if(l.type==='fill-extrusion'&&l.id!=='p-zn-ex'&&l.id!=='p-zn-3d') pMap.setPaintProperty(l.id,'fill-extrusion-opacity',0);
      });}catch(e){}
    },300);
  }
  // Show/hide HTML context markers — per-marker scene visibility
  pCtxMarkers.forEach(function(mk, mi) {
    var marker = P.markers[mi];
    if(!marker) { mk.getElement().style.display = 'none'; return; }
    var scenes = marker.scenes || [];
    // Show if: context layer is on AND (marker has no scene restrictions OR current scene is in its list)
    var sceneId = P.scenes[AS] ? P.scenes[AS].id : null;
    var visibleOnScene = scenes.length === 0 || (sceneId && scenes.indexOf(sceneId) >= 0);
    mk.getElement().style.display = (L.context && visibleOnScene) ? '' : 'none';
  });
  // Per-zone scene visibility in preview
  ps('p-zn-ex', false);
  ps('p-zn-f', L.constraints);
  ps('p-zn-s', L.constraints);
  if(pMap && pMap.getSource('p-zn') && L.constraints) {
    var sceneId = P.scenes[AS] ? P.scenes[AS].id : null;
    var visibleZones = P.zones.filter(function(z) {
      var zs = z.scenes || [];
      return zs.length === 0 || (sceneId && zs.indexOf(sceneId) >= 0);
    });
    pMap.getSource('p-zn').setData({type:'FeatureCollection',features:visibleZones.map(function(z){
      var zco = z.smoothRadius > 0.01 ? smoothPolygon(z.coordinates, z.smoothRadius) : z.coordinates;
      return {type:'Feature',geometry:{type:'Polygon',coordinates:[zco]},properties:{color:z.color,opacity:z.opacity,extrude:!!z.extrude,extrudeHeight:z.extrudeHeight||20}};
    })});
  } else if(pMap && pMap.getSource('p-zn') && !L.constraints) {
    pMap.getSource('p-zn').setData({type:'FeatureCollection',features:[]});
  }
  // Overlay layers
  (P.overlays||[]).forEach(function(ov,i) {
    var lid = 'p-ovl-'+i;
    if(!pMap.getLayer(lid)) return;
    var sceneId = sc ? sc.id : null;
    var show = ov.global || (ov.scenes||[]).length===0
      ? false  // default hidden unless scene or global
      : false;
    // global = always show; scenes[] empty = hide everywhere; else check scene
    if(ov.global) show = true;
    else if((ov.scenes||[]).length>0 && sceneId) show = (ov.scenes.indexOf(sceneId)>=0);
    pMap.setLayoutProperty(lid,'visibility', show?'visible':'none');
  });
  el('pl').textContent = 'Scene '+(AS+1)+' \u00b7 '+(sc.label||'');

  // Only fly when switching scenes, not on data refreshes
  if(!window._pNoFly) pMap.flyTo({center:P.siteCentre,zoom:sc.camera.zoom,pitch:sc.camera.pitch,bearing:sc.camera.bearing,duration:700});
  refreshLines();
}

function refreshRL() { if(pMap&&pMap.getSource('p-rl'))pMap.getSource('p-rl').setData(rlGJ()); }
function refreshMK() {
  renderMarkers();
  if(!pMap || !pReady) return;
  // Remove old markers
  pCtxMarkers.forEach(function(m){ m.remove(); });
  pCtxMarkers = [];
  // Add fresh HTML markers
  P.markers.forEach(function(mk) {
    var el = makeCtxMarkerEl(mk.color, mk.icon);
    var marker = new mapboxgl.Marker({element:el, anchor:'bottom'})
      .setLngLat(mk.coords)
      .addTo(pMap);
    // Check current scene visibility
    var sc = P.scenes[AS];
    el.style.display = (sc && sc.layers.context) ? '' : 'none';
    pCtxMarkers.push(marker);
  });
  // Reapply per-marker scene-visibility now that pCtxMarkers is rebuilt in the current P.markers order
  window._pNoFly=true; updatePreview(); window._pNoFly=false;
}

function refreshZN() {
  var all = znGJ();
  if(pMap&&pMap.getSource('p-zn')) pMap.getSource('p-zn').setData(all);
  var zonesClip={type:'FeatureCollection',features:all.features.filter(function(f){return f.properties&&f.properties.clipMap;})};
  if(pMap&&pMap.getSource('p-zn-clip')) pMap.getSource('p-zn-clip').setData(zonesClip);
  renderZones(); if(pMap&&pReady){ window._pNoFly=true; updatePreview(); window._pNoFly=false; }
}

function refreshOV() {
  if(!pMap||!pReady) return;
  P.overlays = P.overlays || [];
  // Remove old overlay layers/sources
  P.overlays.forEach(function(ov,i) {
    var sid = 'p-ov-'+i, lid = 'p-ovl-'+i;
    if(pMap.getLayer(lid)) pMap.removeLayer(lid);
    if(pMap.getSource(sid)) pMap.removeSource(sid);
  });
  // Re-add all
  P.overlays.forEach(function(ov,i) {
    if(!ov.url||!ov.coords||ov.coords.length<4) return;
    var sid = 'p-ov-'+i, lid = 'p-ovl-'+i;
    try {
      pMap.addSource(sid, {type:'image', url:ov.url,
        coordinates:[ov.coords[0],ov.coords[1],ov.coords[2],ov.coords[3]]});
      var beforeLyr = pMap.getLayer('p-zn-f') ? 'p-zn-f' : (pMap.getLayer('p-ln-l') ? 'p-ln-l' : undefined);
      pMap.addLayer({id:lid, type:'raster', source:sid,
        paint:{'raster-opacity':ov.opacity||0.85,'raster-fade-duration':0},
        layout:{visibility:'none'}}, 'p-rl-f');
    } catch(e) {}
  });
  updatePreview();
}

