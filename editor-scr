function bindRng(id, fn) {
  var e = el(id); if (!e) return;
  var vEl = el(id+'-v');
  var unit = vEl ? (vEl.dataset.unit||'') : '';
  var mn = vEl ? parseFloat(vEl.dataset.min) : parseFloat(e.min);
  var mx = vEl ? parseFloat(vEl.dataset.max) : parseFloat(e.max);
  e.addEventListener('input', function() {
    var v = parseFloat(this.value);
    if (vEl) vEl.value = v + unit;
    fn(v); markDirty();
  });
  if (vEl) {
    function commit() {
      var v = parseFloat(vEl.value);
      if (isNaN(v)) v = parseFloat(e.value);
      v = Math.min(mx, Math.max(mn, v));
      var step = parseFloat(e.step) || 0;
      if (step > 0) v = parseFloat((Math.round(v/step)*step).toFixed(6));
      e.value = v;
      vEl.value = v + unit;
      updateRangeFill(e);
      fn(v); markDirty();
    }
    vEl.addEventListener('keydown', function(ev) { if (ev.key === 'Enter') { commit(); vEl.blur(); } });
    vEl.addEventListener('blur', commit);
  }
}
