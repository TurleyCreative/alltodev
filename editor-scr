  html += '</div>';
  html += '<div class="rs"><div class="st">Corner Coordinates</div>';
  html += '<div class="nt" style="margin-bottom:10px">Click <b style="color:var(--ink)">Place</b> next to a corner, then click the map to drop it. Or use <b style="color:var(--ink)">Fit to red line</b> to auto-fill from your boundary.</div>';
  var corners = ['NW (top-left)','NE (top-right)','SE (bottom-right)','SW (bottom-left)'];
  var cornerIcons = ['corner-up-left','corner-up-right','corner-down-right','corner-down-left'];
  corners.forEach(function(lbl, ci) {
    var co = (ov.coords && ov.coords[ci]) || [0,0];
    html += '<div class="f"><label class="fl ico-h">'+lucideSVG(cornerIcons[ci],12,'currentColor')+lbl+'</label>';
    html += '<div style="display:flex;gap:6px;align-items:center">';
    html += '<input type="number" id="ov-c'+ci+'x" step="0.00001" value="'+co[0]+'" placeholder="lng" style="flex:1"/>';
    html += '<input type="number" id="ov-c'+ci+'y" step="0.00001" value="'+co[1]+'" placeholder="lat" style="flex:1"/>';
    html += '<button class="btn btn-g btn-ic" data-corner="'+ci+'" id="ov-place-'+ci+'" style="white-space:nowrap;font-size:10px;padding:6px 8px" title="Click map to place this corner">'+lucideSVG('crosshair',11,'currentColor')+'Place</button>';
    html += '</div></div>';
  });
  html += '<div id="ov-place-status" style="font-size:11px;font-family:var(--mono);color:var(--accent);margin-top:6px;min-height:16px"></div>';
  html += '<button class="btn btn-g btn-ic" id="ov-fit-btn" style="width:100%;margin-top:8px;justify-content:center">'+lucideSVG('maximize',13,'currentColor')+'Fit to red line boundary</button>';
  html += '</div>';
  setHTML('rpc', html);
  // Bindings
  bindInput('ov-name', function(v){ P.overlays[i].name=v; renderOverlays(); markDirty(); });
  bindInput('ov-url',  function(v){ P.overlays[i].url=v;  refreshOV(); markDirty(); });
  bindImageUpload('ov-url', 2400, function(dataUri){ P.overlays[i].url=dataUri; refreshOV(); });
  var opEl = el('ov-op'), opvEl = el('ov-op-v');
  if(opEl) opEl.addEventListener('input', function() {
    P.overlays[i].opacity = parseFloat(this.value);
    if(opvEl) opvEl.textContent = this.value;
    refreshOV(); markDirty();
  });
  var gTg = el('ov-global');
  if(gTg) gTg.addEventListener('click', function() {
    P.overlays[i].global = !P.overlays[i].global;
    markDirty(); renderOverlayEditor(i);
  });
  (P.scenes||[]).forEach(function(sc,si) {
    var tg = el('ov-sc-'+si);
    if(!tg) return;
    tg.addEventListener('click', function() {
      if(!P.overlays[i].scenes) P.overlays[i].scenes = [];
      var si2 = P.overlays[i].scenes.indexOf(sc.id);
      if(si2 >= 0) { P.overlays[i].scenes.splice(si2,1); tg.classList.remove('on'); }
      else { P.overlays[i].scenes.push(sc.id); tg.classList.add('on'); }
