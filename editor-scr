    '#lb-overlay.layout-popover #lb-box::-webkit-scrollbar,.lb-text-col::-webkit-scrollbar,.lb-panel-text-col::-webkit-scrollbar,.lb-car-text-col::-webkit-scrollbar,#lb-overlay.layout-card #lb-content::-webkit-scrollbar,#lb-overlay.layout-popup-card #lb-content::-webkit-scrollbar{display:none}',
    '.lb-cs-track{position:fixed;width:4px;border-radius:999px;background:rgba(0,0,0,.1);z-index:950;pointer-events:none}',
    '.lb-cs-thumb{position:absolute;left:0;width:4px;border-radius:999px;background:#a5a5a5;cursor:grab;pointer-events:all}',
    '.lb-cs-thumb:active{cursor:grabbing}',
    /* Fullscreen image */
    '#lb-fs{display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.92);align-items:center;justify-content:center;cursor:zoom-out}',
    '#lb-fs.open{display:flex}',
    '#lb-fs img{max-width:92vw;max-height:92vh;object-fit:contain;border-radius:4px}',
    '#lb-fs-close{position:fixed;top:20px;right:20px;background:rgba(255,255,255,.15);border:none;color:#fff;width:40px;height:40px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center}',
    '@media(max-width:768px){',
    '#lb-overlay.layout-image-text #lb-box,#lb-overlay.layout-iframe-text #lb-box{width:95%;height:88vh}',
    '#lb-overlay.layout-image-text #lb-content,#lb-overlay.layout-iframe-text #lb-content{flex-direction:column}',
    '.lb-img-col,.lb-iframe-col{flex:0 0 45%}',
    '.lb-text-col{padding:20px}',
    '#lb-overlay.layout-full #lb-box{width:95%;height:85vh}',
    '}',
  ].join('\n');
}
})(); // end IIFE
