  if(openF) openF.addEventListener('change', function() {
    var file = this.files[0]; if(!file) return;
    var reader = new FileReader();
    reader.onload = function(ev) {
      try {
        var data = JSON.parse(ev.target.result);
        if(!data.scenes || !Array.isArray(data.scenes)) { alert('Invalid project file.'); return; }
        // Migrate missing layer properties
        data.scenes.forEach(function(sc) {
          if(!sc.layers) sc.layers = {};
