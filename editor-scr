// ── ENTRANCE ANIMATION CONTROLS (shared: Settings + per-line overrides) ──
var EASE_LABELS = {linear:'Linear', easeIn:'Ease In', easeOut:'Ease Out', easeInOut:'Ease In Out', bounce:'Bounce', custom:'Custom…'};
var DEFAULT_EASING_CURVE = [0.42, 0, 0.58, 1];
var EG_W = 200, EG_H = 72, EG_PAD = 6;
function bezierEasing(x1, y1, x2, y2) {
  function A(a1,a2){ return 1-3*a2+3*a1; }
  function B(a1,a2){ return 3*a2-6*a1; }
  function C(a1){ return 3*a1; }
  function calcBezier(t,a1,a2){ return ((A(a1,a2)*t+B(a1,a2))*t+C(a1))*t; }
  function getSlope(t,a1,a2){ return 3*A(a1,a2)*t*t+2*B(a1,a2)*t+C(a1); }
  return function(x) {
    if(x1===y1 && x2===y2) return x;
    var t = x;
    for(var i=0;i<8;i++) {
      var slope = getSlope(t,x1,x2);
      if(Math.abs(slope)<1e-6) break;
      t -= (calcBezier(t,x1,x2)-x)/slope;
    }
    t = Math.min(1, Math.max(0,t));
    return calcBezier(t,y1,y2);
  };
}
function easingFn(name, t, curve) {
  switch(name) {
    case 'linear': return t;
    case 'easeIn': return t*t*t;
    case 'easeInOut': return t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2;
    case 'bounce':
      var n1=7.5625, d1=2.75;
      if(t<1/d1) return n1*t*t;
      if(t<2/d1) return n1*(t-=1.5/d1)*t+0.75;
      if(t<2.5/d1) return n1*(t-=2.25/d1)*t+0.9375;
      return n1*(t-=2.625/d1)*t+0.984375;
    case 'custom':
      curve = curve || DEFAULT_EASING_CURVE;
      return bezierEasing(curve[0],curve[1],curve[2],curve[3])(t);
    default: return 1-Math.pow(1-t,3); // easeOut
  }
}
function easingGraphSVG(name, curve) {
  var w=EG_W, h=EG_H, pad=EG_PAD, steps=48, pts=[];
  for(var i=0;i<=steps;i++) {
    var t=i/steps, e=easingFn(name,t,curve);
    var x=pad+t*(w-2*pad), y=(h-pad)-e*(h-2*pad);
    pts.push(x.toFixed(1)+','+y.toFixed(1));
  }
  var grid = '';
  for(var gi=1; gi<4; gi++) {
    var gx = pad + (gi/4)*(w-2*pad);
    grid += '<line x1="'+gx.toFixed(1)+'" y1="'+pad+'" x2="'+gx.toFixed(1)+'" y2="'+(h-pad)+'" stroke="var(--border2)" stroke-width="1" opacity=".35"/>';
  }
  for(var gj=1; gj<4; gj++) {
    var gy = pad + (gj/4)*(h-2*pad);
    grid += '<line x1="'+pad+'" y1="'+gy.toFixed(1)+'" x2="'+(w-pad)+'" y2="'+gy.toFixed(1)+'" stroke="var(--border2)" stroke-width="1" opacity=".35"/>';
  }
  var extra = '', handles = '';
  if(name==='custom') {
    curve = curve || DEFAULT_EASING_CURVE;
    var x0=pad, y0=h-pad, x3=w-pad, y3=pad;
    var x1=pad+curve[0]*(w-2*pad), y1=(h-pad)-curve[1]*(h-2*pad);
    var x2=pad+curve[2]*(w-2*pad), y2=(h-pad)-curve[3]*(h-2*pad);
    extra = '<line class="eg-guide1" x1="'+x0+'" y1="'+y0+'" x2="'+x1+'" y2="'+y1+'" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2,2" opacity=".6"/>'
      + '<line class="eg-guide2" x1="'+x3+'" y1="'+y3+'" x2="'+x2+'" y2="'+y2+'" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2,2" opacity=".6"/>';
    handles = '<div class="eg-handle" data-idx="0" tabindex="0" role="slider" aria-label="First control point" style="left:'+((x1/w)*100).toFixed(2)+'%;top:'+((y1/h)*100).toFixed(2)+'%"></div>'
      + '<div class="eg-handle" data-idx="1" tabindex="0" role="slider" aria-label="Second control point" style="left:'+((x2/w)*100).toFixed(2)+'%;top:'+((y2/h)*100).toFixed(2)+'%"></div>';
  }
  return '<div class="eg-wrap" style="position:relative">'
    + '<svg width="100%" height="'+h+'" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none" style="display:block;overflow:visible;touch-action:none">'
    + grid
    + '<line x1="'+pad+'" y1="'+(h-pad)+'" x2="'+(w-pad)+'" y2="'+(h-pad)+'" stroke="var(--border2)" stroke-width="1"/>'
    + '<line x1="'+pad+'" y1="'+pad+'" x2="'+pad+'" y2="'+(h-pad)+'" stroke="var(--border2)" stroke-width="1"/>'
    + '<path class="eg-curve" d="M'+pts.join(' L')+'" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>'
    + extra
    + '</svg>'
    + handles
    + '</div>';
}
function animControlsHTML(prefix, dur, easing, delay, curve) {
  easing = easing || 'easeOut';
  var opts = ['linear','easeIn','easeOut','easeInOut','bounce','custom'].map(function(k) {
    return '<option value="'+k+'"'+(easing===k?' selected':'')+'>'+EASE_LABELS[k]+'</option>';
  }).join('');
  return rng(prefix+'-dur','Duration',100,3000,50,dur||800,'ms')
    + '<div class="f"><label class="fl">Easing</label><select id="'+prefix+'-ease">'+opts+'</select>'
    + '<div id="'+prefix+'-ease-graph" style="margin-top:8px;padding:8px;background:var(--bg);border:1px solid var(--border);border-radius:8px">'+easingGraphSVG(easing, curve)+'</div>'
    + '<div id="'+prefix+'-ease-demo" style="position:relative;height:26px;margin-top:8px;background:var(--bg);border:1px solid var(--border);border-radius:8px;overflow:hidden">'
      + '<div class="eg-demo-track" style="position:absolute;top:50%;left:10px;right:10px;height:2px;background:var(--border2);transform:translateY(-50%)"></div>'
      + '<div class="eg-demo-dot" style="position:absolute;top:50%;left:10px;width:12px;height:12px;border-radius:50%;background:var(--accent);transform:translate(-50%,-50%)"></div>'
      + '</div>'
    + '</div>'
    + rng(prefix+'-delay','Delay',0,2000,50,delay||0,'ms');
}
function bindAnimControls(prefix, onDur, onEase, onDelay, getCurve, onCurveRaw) {
  var onCurve = function(curve, live) { if(onCurveRaw) onCurveRaw(curve, live); playEasingDemo(prefix); };
  bindRng(prefix+'-dur', function(v) { onDur(v); playEasingDemo(prefix); });
  bindInput(prefix+'-ease', function(v) {
    onEase(v);
    var g = el(prefix+'-ease-graph');
    if(g) { g.innerHTML = easingGraphSVG(v, getCurve ? getCurve() : null); bindEasingGraphDrag(prefix+'-ease-graph', getCurve, onCurve); }
    playEasingDemo(prefix);
  });
  bindRng(prefix+'-delay', function(v) { onDelay(v); playEasingDemo(prefix); });
  bindEasingGraphDrag(prefix+'-ease-graph', getCurve, onCurve);
  var demo = el(prefix+'-ease-demo');
  if(demo) demo._getCurve = getCurve;
  playEasingDemo(prefix);
}
function playEasingDemo(prefix) {
  var demo = el(prefix+'-ease-demo');
  if(!demo) return;
  var dot = demo.querySelector('.eg-demo-dot');
  if(!dot) return;
  demo._sess = (demo._sess||0) + 1;
  var mySess = demo._sess;
  function cycle() {
    if(mySess !== demo._sess || !document.body.contains(demo)) return;
    var durEl = el(prefix+'-dur'), delayEl = el(prefix+'-delay'), easeEl = el(prefix+'-ease');
    var dur = durEl ? parseFloat(durEl.value)||800 : 800;
    var delay = delayEl ? parseFloat(delayEl.value)||0 : 0;
    var name = easeEl ? easeEl.value : 'easeOut';
    var curve = demo._getCurve ? demo._getCurve() : null;
    var start = null, pad = 10;
    dot.style.left = pad + 'px';
    function frame(ts) {
      if(mySess !== demo._sess) return;
      if(!start) start = ts;
      var elapsed = ts - start - delay;
      if(elapsed < 0) { requestAnimationFrame(frame); return; }
      var t = Math.min(1, elapsed/dur);
      var e = easingFn(name, t, curve);
      var w = demo.clientWidth - 2*pad;
      dot.style.left = (pad + e*w) + 'px';
      if(t < 1) requestAnimationFrame(frame);
      else setTimeout(function() { if(mySess === demo._sess) cycle(); }, 500);
    }
    requestAnimationFrame(frame);
  }
  cycle();
}
function bindEasingGraphDrag(graphElId, getCurve, onCurve) {
  var container = el(graphElId);
  if(!container || !getCurve || !onCurve) return;
  var wrap = container.querySelector('.eg-wrap');
  if(!wrap) return;
  var svg = wrap.querySelector('svg');
  var w=EG_W, h=EG_H, pad=EG_PAD;
  function redraw(curve) {
    var path = svg.querySelector('.eg-curve');
    if(path) {
      var pts=[];
      for(var i=0;i<=48;i++) { var t=i/48, e=easingFn('custom',t,curve); pts.push((pad+t*(w-2*pad)).toFixed(1)+','+((h-pad)-e*(h-2*pad)).toFixed(1)); }
      path.setAttribute('d','M'+pts.join(' L'));
    }
    var x1=pad+curve[0]*(w-2*pad), y1=(h-pad)-curve[1]*(h-2*pad);
    var x2=pad+curve[2]*(w-2*pad), y2=(h-pad)-curve[3]*(h-2*pad);
    var g1=svg.querySelector('.eg-guide1'), g2=svg.querySelector('.eg-guide2');
    if(g1){ g1.setAttribute('x2',x1); g1.setAttribute('y2',y1); }
    if(g2){ g2.setAttribute('x2',x2); g2.setAttribute('y2',y2); }
    var h1=wrap.querySelector('[data-idx="0"]'), h2=wrap.querySelector('[data-idx="1"]');
    if(h1){ h1.style.left=((x1/w)*100)+'%'; h1.style.top=((y1/h)*100)+'%'; }
    if(h2){ h2.style.left=((x2/w)*100)+'%'; h2.style.top=((y2/h)*100)+'%'; }
  }
  wrap.querySelectorAll('.eg-handle').forEach(function(handle) {
    var idx = parseInt(handle.dataset.idx);
    function moveTo(clientX, clientY) {
      var rect = wrap.getBoundingClientRect();
      var nx = ((clientX-rect.left)/rect.width*w - pad)/(w-2*pad);
      var ny = (h-pad-((clientY-rect.top)/rect.height*h))/(h-2*pad);
      nx = Math.min(1, Math.max(0, nx));
      ny = Math.min(1.5, Math.max(-0.5, ny));
      var curve = getCurve().slice();
      curve[idx*2] = parseFloat(nx.toFixed(3));
      curve[idx*2+1] = parseFloat(ny.toFixed(3));
      onCurve(curve, true);
      redraw(curve);
    }
    handle.addEventListener('pointerdown', function(e) {
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      function move(ev) { moveTo(ev.clientX, ev.clientY); }
      function up(ev) {
        wrap.removeEventListener('pointermove', move);
        wrap.removeEventListener('pointerup', up);
        onCurve(getCurve(), false);
        markDirty();
      }
      wrap.addEventListener('pointermove', move);
      wrap.addEventListener('pointerup', up);
    });
    handle.addEventListener('keydown', function(e) {
      var step = e.shiftKey ? 0.1 : 0.02;
      var curve = getCurve().slice();
      var dx=0, dy=0;
      if(e.key==='ArrowLeft') dx=-step; else if(e.key==='ArrowRight') dx=step;
      else if(e.key==='ArrowUp') dy=step; else if(e.key==='ArrowDown') dy=-step;
      else return;
      e.preventDefault();
      curve[idx*2] = Math.min(1, Math.max(0, parseFloat((curve[idx*2]+dx).toFixed(3))));
      curve[idx*2+1] = Math.min(1.5, Math.max(-0.5, parseFloat((curve[idx*2+1]+dy).toFixed(3))));
      onCurve(curve, false);
      redraw(curve);
      markDirty();
    });
  });
}

