        + '<div style="font-size:11px;font-weight:500;color:var(--ink)">'+l.label+'</div>'
        + '<div style="font-size:9px;color:var(--ghost);font-family:var(--mono)">'+l.desc+'</div>'
        + '</button>';
    });
    html += '</div></div>';
    var zlbLy = zlb.layout||'popover';
    if(zlbLy !== 'full') {
      html += fld('Heading','zn-lb-head',h(zlb.heading||''));
      html += fld('Subheading','zn-lb-sub',h(zlb.subheading||''));
      html += '<div class="f"><label class="fl">Body</label><textarea id="zn-lb-body">'+h(zlb.body||'')+'</textarea></div>';
