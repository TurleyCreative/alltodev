  html += '<div class="lr" style="margin-bottom:10px"><span class="ll">Enable lightbox on click</span><button class="tg'+(zlb.enabled?' on':'')+'" id="zn-lb-tog"></button></div>';
  if(zlb.enabled) {
    var zlbLayouts = [{id:'full',label:'Full Panel',desc:'iframe only'},{id:'image-text',label:'Image + Text',desc:'40/60 split'},{id:'iframe-text',label:'Iframe + Text',desc:'40/60 interactive'},{id:'popover',label:'Popover',desc:'Text near zone'}];
    html += '<div class="f"><label class="fl">Layout</label><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:4px">';
