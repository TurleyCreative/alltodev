function openDraw(type, idx) {
  if(!pMap || !pReady) { alert('Preview map not ready — paste your Mapbox token first'); return; }
  if(!pDraw) initDraw();
  if(!pDraw) { alert('Draw tool not available'); return; }
  drawTargetType = type;
  drawTargetIdx = idx;
  pDraw.deleteAll();

  // Pre-load existing geometry if any
  var existing = type === 'zone' ? (P.zones[idx] && P.zones[idx].coordinates) : null;
  var existingGJ = type === 'line' ? (P.lines[idx] && P.lines[idx].geojson) : null;

  if(existing && existing.length > 2) {
    pDraw.add({ type:'Feature', geometry:{ type:'Polygon', coordinates:[existing] }, properties:{} });
  } else if(existingGJ) {
    try {
      var gj = JSON.parse(existingGJ);
      if(gj.type === 'FeatureCollection') gj.features.forEach(function(f){ pDraw.add(f); });
      else pDraw.add(gj);
    } catch(e) {}
  }

  // Show toolbar, hide draw mode selector
  var tb = el('draw-toolbar');
  if(tb) { tb.style.display = 'flex'; }
  var polyBtn = el('draw-poly-btn');
  var lineBtn = el('draw-line-btn');
  if(polyBtn) polyBtn.style.display = (type === 'zone' || type === 'building') ? 'block' : 'none';
  if(lineBtn) lineBtn.style.display = (type === 'line') ? 'block' : 'none';

  // Auto-start the right draw mode
  if(type === 'zone' || type === 'building') {
    pDraw.changeMode('draw_polygon');
    drawMode = 'polygon';
  } else {
    pDraw.changeMode('draw_line_string');
    drawMode = 'line_string';
  }
}

function closeDraw() {
  if(pDraw) {
    try { pDraw.changeMode('simple_select'); } catch(e) {}
    try { pDraw.deleteAll(); } catch(e) {}
  }
  var tb = el('draw-toolbar');
  if(tb) { tb.style.cssText = tb.style.cssText.replace(/display:[^;]+;?/g,''); tb.style.display = 'none'; }
  drawTargetType = null; drawTargetIdx = -1;
  // Force hide after any async redraws
  setTimeout(function(){ var tb=el('draw-toolbar'); if(tb){ tb.style.cssText=tb.style.cssText.replace(/display:[^;]+;?/g,''); tb.style.display='none'; } }, 200);
}

function applyDraw() {
  if(!pDraw) return;
  // Commit any in-progress drawing before reading
  try { pDraw.changeMode('simple_select'); } catch(e) {}
  var data = pDraw.getAll();
  if(!data.features.length) { closeDraw(); return; }

  if(drawTargetType === 'building' && drawTargetIdx >= 0) {
    var poly2 = data.features.find(function(f){ return f.geometry && f.geometry.type === 'Polygon'; });
    if(!poly2) { alert('No polygon found — double-click to finish drawing, then Apply'); return; }
    var fc2 = {type:'FeatureCollection', features:[{type:'Feature',geometry:poly2.geometry,properties:{}}]};
    var _bIdx = drawTargetIdx;
    P.buildings[_bIdx].geojson = JSON.stringify(fc2);
    markDirty();
    closeDraw();
    renderBuildingEditor(_bIdx);
    refreshBuildings();
  } else if(drawTargetType === 'zone' && drawTargetIdx >= 0) {
    // Get the LAST polygon - user may have drawn over existing pre-loaded one
    var _polys = data.features.filter(function(f){ return f.geometry && f.geometry.type === 'Polygon'; });
    var poly = _polys[_polys.length - 1];
    if(!poly) { alert('No polygon found — double-click to finish drawing, then Apply'); return; }
    var _zIdx = drawTargetIdx;
    P.zones[_zIdx].coordinates = poly.geometry.coordinates[0];
    markDirty();
    closeDraw();
    refreshZN();
  } else if(drawTargetType === 'line' && drawTargetIdx >= 0) {
    var lineFeats = data.features.filter(function(f){ return f.geometry && (f.geometry.type==='LineString'||f.geometry.type==='MultiLineString'); });
    if(!lineFeats.length) { alert('No line found — double-click to finish drawing, then Apply'); return; }
    var fc = { type:'FeatureCollection', features: lineFeats };
    var _lIdx = drawTargetIdx;
    P.lines[_lIdx].geojson = JSON.stringify(fc);
    markDirty();
    closeDraw();
    renderLineEditor(_lIdx);
    refreshLines();
  } else {
    closeDraw();
  }
}

