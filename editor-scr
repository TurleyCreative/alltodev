function renderGroupHeader(g, gi, groups, itemsKey, renderFn) {
  var items = P[itemsKey] || [];
  var count = items.filter(function(it){ return it.groupId===g.id; }).length;
  var div = mk('div', 'grp-hdr');
  div.innerHTML =
    '<button class="grp-chev" data-ga="toggle" aria-label="'+(g.collapsed?'Expand':'Collapse')+' group">'+lucideSVG(g.collapsed?'chevron-right':'chevron-down',13,'currentColor')+'</button>'+
    '<span class="grp-name" data-ga="rename" title="Click to rename">'+h(g.name||'Group')+'</span>'+
    '<span class="grp-count">'+count+'</span>'+
    '<div class="ia">'+
      (gi>0?'<button class="ib" data-ga="up" title="Move group up">'+lucideSVG('arrow-up',11,'currentColor')+'</button>':'')+
      (gi<groups.length-1?'<button class="ib" data-ga="dn" title="Move group down">'+lucideSVG('arrow-down',11,'currentColor')+'</button>':'')+
      '<button class="ib d" data-ga="del" title="Delete group">'+lucideSVG('trash-2',11,'currentColor')+'</button>'+
    '</div>';
  div.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-ga]');
    if(!btn) return;
    e.stopPropagation();
    var ga = btn.dataset.ga;
    if(ga==='toggle') { g.collapsed = !g.collapsed; renderFn(); }
    else if(ga==='rename') {
      var nm = prompt('Rename group', g.name||'');
      if(nm!=null && nm.trim()) { g.name = nm.trim(); markDirty(); renderFn(); }
    }
    else if(ga==='up') { var idx=groups.indexOf(g); if(idx>0){ groups.splice(idx,1); groups.splice(idx-1,0,g); markDirty(); renderFn(); } }
    else if(ga==='dn') { var idx2=groups.indexOf(g); if(idx2<groups.length-1){ groups.splice(idx2,1); groups.splice(idx2+1,0,g); markDirty(); renderFn(); } }
    else if(ga==='del') {
      if(confirm('Delete group "'+(g.name||'Group')+'"? Items inside will become ungrouped.')) {
        items.forEach(function(it){ if(it.groupId===g.id) it.groupId=null; });
        var pos = groups.indexOf(g);
        groups.splice(pos,1);
        markDirty(); renderFn();
      }
    }
  });
  makeGroupHeaderDroppable(div, itemsKey, g.id, renderFn);
  return div;
}

function moveItemInScope(itemsKey, i, dir, renderFn, selRef) {
  var items = P[itemsKey] || [];
  var it = items[i];
  if(!it) return;
  var gid = it.groupId || null;
  var idxs = [];
  items.forEach(function(x, xi) { if((x.groupId||null)===gid) idxs.push(xi); });
  var pos = idxs.indexOf(i), newPos = pos + dir;
  if(newPos<0 || newPos>=idxs.length) return;
  var j = idxs[newPos];
  var tmp = items[i]; items[i] = items[j]; items[j] = tmp;
  if(selRef) {
    var cur = selRef.get();
    if(cur===i) selRef.set(j); else if(cur===j) selRef.set(i);
  }
  markDirty(); renderFn();
}

function groupSelectOptions(groupsKey, curGroupId) {
  var groups = P[groupsKey] || [];
  var html = '<option value=""'+(!curGroupId?' selected':'')+'>No group</option>';
  groups.forEach(function(g) {
    html += '<option value="'+h(g.id)+'"'+(curGroupId===g.id?' selected':'')+'>'+h(g.name||'Group')+'</option>';
  });
  html += '<option value="__new__">+ New group…</option>';
  return html;
}

function bindGroupSelect(selId, groupsKey, item, renderFn) {
  var sel = el(selId);
  if(!sel) return;
  sel.addEventListener('change', function() {
    if(sel.value==='__new__') {
      var nm = prompt('New group name', '');
      if(nm!=null && nm.trim()) {
        var groups = grpArr(groupsKey);
        var g = {id:'grp'+Date.now()+Math.floor(Math.random()*1000), name:nm.trim(), collapsed:false};
        groups.push(g);
        item.groupId = g.id;
      } else {
        sel.value = item.groupId||'';
        return;
      }
    } else {
      item.groupId = sel.value || null;
    }
    markDirty(); renderFn();
  });
}

// ── Drag & drop reordering / group assignment ──
function parseDragData(e, itemsKey) {
  try {
    var data = JSON.parse(e.dataTransfer.getData('text/plain'));
    if(data && data.itemsKey===itemsKey) return data;
  } catch(err) {}
  return null;
}

function makeRowDraggable(div, itemsKey, i, renderFn) {
  div.draggable = true;
  div.addEventListener('dragstart', function(e) {
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', JSON.stringify({itemsKey:itemsKey, index:i}));
    div.classList.add('dragging');
  });
  div.addEventListener('dragend', function() {
    div.classList.remove('dragging');
    document.querySelectorAll('.drag-over').forEach(function(x){ x.classList.remove('drag-over'); });
  });
  div.addEventListener('dragover', function(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    div.classList.add('drag-over');
  });
  div.addEventListener('dragleave', function() { div.classList.remove('drag-over'); });
  div.addEventListener('drop', function(e) {
    e.preventDefault();
    e.stopPropagation();
    div.classList.remove('drag-over');
    var data = parseDragData(e, itemsKey);
    if(!data) return;
    dropItemOntoRow(itemsKey, data.index, i, renderFn);
  });
}

function makeGroupHeaderDroppable(div, itemsKey, groupId, renderFn) {
  div.addEventListener('dragover', function(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    div.classList.add('drag-over');
  });
  div.addEventListener('dragleave', function() { div.classList.remove('drag-over'); });
  div.addEventListener('drop', function(e) {
    e.preventDefault();
    e.stopPropagation();
    div.classList.remove('drag-over');
    var data = parseDragData(e, itemsKey);
    if(!data) return;
    dropItemOnGroup(itemsKey, data.index, groupId, renderFn);
  });
}

function makeListContainerDroppable(ul, itemsKey, renderFn) {
  ul.addEventListener('dragover', function(e) {
    if(e.target !== ul) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  });
  ul.addEventListener('drop', function(e) {
    if(e.target !== ul) return;
    e.preventDefault();
    var data = parseDragData(e, itemsKey);
    if(!data) return;
    var items = P[itemsKey] || [];
    var moved = items[data.index];
    if(!moved) return;
    items.splice(data.index, 1);
    items.push(moved);
    moved.groupId = null;
    markDirty(); renderFn();
  });
}

function dropItemOntoRow(itemsKey, fromIdx, toIdx, renderFn) {
  var items = P[itemsKey] || [];
  var moved = items[fromIdx], target = items[toIdx];
  if(!moved || !target || moved===target) return;
  var newGroupId = target.groupId || null;
  items.splice(fromIdx, 1);
  var insertAt = items.indexOf(target);
  items.splice(insertAt, 0, moved);
  moved.groupId = newGroupId;
  markDirty(); renderFn();
}

function dropItemOnGroup(itemsKey, fromIdx, groupId, renderFn) {
  var items = P[itemsKey] || [];
  var moved = items[fromIdx];
  if(!moved) return;
  items.splice(fromIdx, 1);
  var lastIdx = -1;
  items.forEach(function(it, idx){ if((it.groupId||null)===(groupId||null)) lastIdx = idx; });
  var insertAt = lastIdx>=0 ? lastIdx+1 : items.length;
  items.splice(insertAt, 0, moved);
  moved.groupId = groupId || null;
  markDirty(); renderFn();
}

