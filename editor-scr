function bldGJ() {
  var features = [];
  (P.buildings||[]).forEach(function(b) {
    if(!b.geojson) return;
    try {
      var gj = JSON.parse(b.geojson);
      var geoms = [];
      if(gj.type==='FeatureCollection') gj.features.forEach(function(f){ if(f.geometry.type==='Polygon'||f.geometry.type==='MultiPolygon') geoms.push(f.geometry); });
      else if(gj.type==='Feature') geoms.push(gj.geometry);
      else if(gj.type==='Polygon'||gj.type==='MultiPolygon') geoms.push(gj);
      geoms.forEach(function(g){
        features.push({type:'Feature',geometry:g,properties:{color:b.color||'#8899aa',height:b.height||20,opacity:b.opacity||0.85}});
      });
    } catch(e) {}
  });
  return {type:'FeatureCollection', features:features};
}

