  // Corner type inputs
  for(var ci=0; ci<4; ci++) {
    (function(ci2) {
      var xEl = el('ov-c'+ci2+'x'), yEl = el('ov-c'+ci2+'y');
      function updateCorner() {
        if(!P.overlays[i].coords) P.overlays[i].coords = [[0,0],[0,0],[0,0],[0,0]];
        var x = parseFloat(xEl?xEl.value:0), y = parseFloat(yEl?yEl.value:0);
        if(!isNaN(x)&&!isNaN(y)) { P.overlays[i].coords[ci2]=[x,y]; refreshOV(); markDirty(); }
      }
      if(xEl) xEl.addEventListener('input', updateCorner);
      if(yEl) yEl.addEventListener('input', updateCorner);
    })(ci);
  }

  // Click-to-place corner buttons
  var _ovPlaceActive = -1; // which corner is awaiting a click
  function cancelOvPlace() {
    _ovPlaceActive = -1;
    if(pMap) pMap.getCanvas().style.cursor = '';
    var st = el('ov-place-status'); if(st) st.textContent = '';
    for(var ci=0;ci<4;ci++) {
      var btn = el('ov-place-'+ci);
      if(btn) { btn.innerHTML = lucideSVG('crosshair',11,'currentColor')+'Place'; btn.style.background=''; btn.style.color=''; }
    }
  }
  for(var ci=0; ci<4; ci++) {
    (function(ci2) {
      var placeBtn = el('ov-place-'+ci2);
      if(!placeBtn) return;
      placeBtn.addEventListener('click', function() {
        if(_ovPlaceActive === ci2) { cancelOvPlace(); return; }
        cancelOvPlace();
        _ovPlaceActive = ci2;
        var names = ['NW','NE','SE','SW'];
        var st = el('ov-place-status');
        if(st) st.textContent = 'Click the map to place the ' + names[ci2] + ' corner...';
        if(pMap) pMap.getCanvas().style.cursor = 'crosshair';
        this.innerHTML = lucideSVG('square',11,'currentColor')+'Cancel';
        this.style.background = 'var(--accent)';
        this.style.color = '#fff';
        // Listen for one map click
        pMap.once('click', function(e) {
          if(_ovPlaceActive !== ci2) return;
          if(!P.overlays[i].coords) P.overlays[i].coords = [[0,0],[0,0],[0,0],[0,0]];
          var lng = parseFloat(e.lngLat.lng.toFixed(6));
          var lat = parseFloat(e.lngLat.lat.toFixed(6));
          P.overlays[i].coords[ci2] = [lng, lat];
          // Update inputs
          var xEl = el('ov-c'+ci2+'x'), yEl = el('ov-c'+ci2+'y');
          if(xEl) xEl.value = lng;
          if(yEl) yEl.value = lat;
          cancelOvPlace();
          refreshOV(); markDirty();
          // Move to next corner automatically
          var nextBtn = el('ov-place-'+(ci2+1));
          if(nextBtn && ci2 < 3) setTimeout(function(){ nextBtn.click(); }, 100);
        });
      });
    })(ci);
  }

  // Fit to red line — use actual polygon shape, not just bounding box
  var fitBtn = el('ov-fit-btn');
  if(fitBtn) fitBtn.addEventListener('click', function() {
    var coords = P.redLine && P.redLine.coordinates;
    if(!coords||coords.length<3) { alert('Add a red line boundary first.'); return; }
    var lngs=coords.map(function(p){return p[0];}), lats=coords.map(function(p){return p[1];});
    var minLng=Math.min.apply(null,lngs), maxLng=Math.max.apply(null,lngs);
    var minLat=Math.min.apply(null,lats), maxLat=Math.max.apply(null,lats);
    // Add 10% padding so image slightly overlaps boundary
    var padLng=(maxLng-minLng)*0.1, padLat=(maxLat-minLat)*0.1;
    P.overlays[i].coords=[
      [minLng-padLng, maxLat+padLat],  // NW
      [maxLng+padLng, maxLat+padLat],  // NE
      [maxLng+padLng, minLat-padLat],  // SE
      [minLng-padLng, minLat-padLat]   // SW
    ];
    markDirty(); renderOverlayEditor(i); refreshOV();
  });
}

