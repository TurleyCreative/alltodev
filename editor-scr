function grpArr(groupsKey) { return P[groupsKey] || (P[groupsKey] = []); }

function addGroup(groupsKey, renderFn) {
  grpArr(groupsKey).push({id:'grp'+Date.now()+Math.floor(Math.random()*1000), name:'New Group', collapsed:false});
