function updatePreview() {
  if (!pMap) return;
  if (!pMap.isStyleLoaded()) { pMap.once('style.load',function(){updatePreview();}); return; }
  // Close any open popups when switching scene in preview
  if(pMap) { try { pMap.getContainer().querySelectorAll('.mapboxgl-popup').forEach(function(e){e.remove();}); } catch(e){} }
  var sc = P.scenes[AS]; if (!sc) return;

  var L = sc.layers;
