  setHTML('rpc', html);

  bindInput('zn-name', function(v) { P.zones[i].name=v; renderZones(); refreshZN(); });
  bindGroupSelect('zn-group', 'zoneGroups', P.zones[i], function(){ renderZones(); renderZoneEditor(i); });
  bindTA('zn-popup', function(v) { P.zones[i].popup=v; });
  var hoverTog = el('zn-hover-tog');
  if(hoverTog) hoverTog.addEventListener('click', function(){
    P.zones[i].showHover = (P.zones[i].showHover === false);
    markDirty(); renderZoneEditor(i);
  });
  var clipTog = el('zn-clip-tog');
  if(clipTog) clipTog.addEventListener('click', function(){
    P.zones[i].clipMap = !P.zones[i].clipMap;
    markDirty(); renderZoneEditor(i); refreshZN();
  });
  var showDrawerTog = el('zn-showdrawer-tog');
  if(showDrawerTog) showDrawerTog.addEventListener('click', function(){
    P.zones[i].showInDrawer = P.zones[i].showInDrawer===false ? true : false;
    markDirty(); renderZoneEditor(i);
  });
  var tog3d = el('zn-3d-tog');
  if(tog3d) tog3d.addEventListener('click', function(){
    P.zones[i].render3d = !P.zones[i].render3d;
    markDirty(); renderZoneEditor(i); refreshZN();
  });
  bindInput('zn-3d-h', function(v){ P.zones[i].height3d=parseInt(v)||20; markDirty(); refreshZN(); });
  var cp = el('zn-col-p'), ct = el('zn-col-t');
  if (cp) cp.addEventListener('input', function() { P.zones[i].color=this.value; if(ct)ct.value=this.value; renderZones(); refreshZN(); });
  if (ct) ct.addEventListener('input', function() { P.zones[i].color=this.value; if(cp)cp.value=this.value; renderZones(); refreshZN(); });
  var op = el('zn-op'), opv = el('zn-op-v');
  if (op) op.addEventListener('input', function() { P.zones[i].opacity=parseFloat(this.value); if(opv)opv.textContent=this.value; refreshZN(); });
  var sm = el('zn-sm'), smv = el('zn-sm-v');

  if (sm) sm.addEventListener('input', function() { P.zones[i].smoothRadius=parseFloat(this.value); if(smv)smv.textContent=parseFloat(this.value).toFixed(2); refreshZN(); markDirty(); });
  // Lightbox bindings
  var znLbTog = el('zn-lb-tog');
  if(znLbTog) znLbTog.addEventListener('click', function() {
    if(!P.zones[i].lightbox) P.zones[i].lightbox={enabled:false,layout:'popover',heading:'',subheading:'',body:'',img:'',imgCaption:'',embedUrl:''};
    P.zones[i].lightbox.enabled = !P.zones[i].lightbox.enabled;
    markDirty(); renderZoneEditor(i);
  });
  document.querySelectorAll('[data-zlayout]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if(!P.zones[i].lightbox) P.zones[i].lightbox={enabled:true,layout:'popover',heading:'',subheading:'',body:'',img:'',imgCaption:'',embedUrl:''};
      P.zones[i].lightbox.layout = this.dataset.zlayout;
      markDirty(); renderZoneEditor(i);
    });
  });
  bindInput('zn-lb-head',  function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.heading=v; });
  bindInput('zn-lb-sub',   function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.subheading=v; });
  bindTA('zn-lb-body',     function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.body=v; });
  bindInput('zn-lb-embed', function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.embedUrl=v; });
  bindInput('zn-lb-img',   function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.img=v; });
  bindImageUpload('zn-lb-img', 1600, function(dataUri){ if(P.zones[i].lightbox) P.zones[i].lightbox.img=dataUri; });
  bindInput('zn-lb-imgcap',function(v){ if(P.zones[i].lightbox) P.zones[i].lightbox.imgCaption=v; });
  var znDrawBtn = el('zn-draw-btn');
  if(znDrawBtn) znDrawBtn.addEventListener('click', function(){ openDraw('zone', i); });
  var co = el('zn-coords');
  if (co) co.addEventListener('input', function() {
    try { var v=JSON.parse(this.value); if(Array.isArray(v)){P.zones[i].coordinates=v;refreshZN();} } catch(e) {}
  });
  // Scene visibility toggles
  P.scenes.forEach(function(sc, si) {
    var tg = el('zn-sc-'+si);
    if(!tg) return;
    tg.addEventListener('click', function() {
      if(!P.zones[i].scenes) P.zones[i].scenes = [];
      var idx2 = P.zones[i].scenes.indexOf(sc.id);
      if(idx2 >= 0) {
        P.zones[i].scenes.splice(idx2, 1);
        tg.classList.remove('on');
      } else {
        P.zones[i].scenes.push(sc.id);
        tg.classList.add('on');
      }
      markDirty(); refreshZN();
    });
  });
}

