    detail: r1.toFixed(2)+':1 — needs 4.5:1 for normal-size text'});
  var accent = P.accentColor || '#c0392b';
  var r2 = contrastRatio(accent, '#ffffff');
  items.push({label:'Accent colour contrast (white button text on Accent colour)', status: r2>=4.5?'pass':(r2>=3?'warn':'fail'),
    detail: r2.toFixed(2)+':1 — needs 4.5:1 (3:1 if the button text is large/bold)'});
  var pSize = P.pSize || 15;
  items.push({label:'Body text size', status: pSize>=12?'pass':'warn',
    detail: pSize+'px — recommended minimum is 12px'});
  var emptyScenes = (P.scenes||[]).filter(function(s){ return !s.title || !(s.body||'').replace(/<[^>]*>/g,'').trim(); });
  items.push({label:'Every scene has a heading and body copy', status: emptyScenes.length===0?'pass':'warn',
    detail: emptyScenes.length===0 ? 'All '+(P.scenes||[]).length+' scenes have content' : emptyScenes.length+' scene(s) are missing a title or body — screen reader users rely on this text since they can\'t see the map'});
  var unnamedMarkers = (P.markers||[]).filter(function(m){ return !m.name || /^new marker$/i.test(m.name.trim()); });
  items.push({label:'Markers have descriptive names', status: unnamedMarkers.length===0?'pass':'warn',
    detail: unnamedMarkers.length===0 ? 'All markers have descriptive names' : unnamedMarkers.length+' marker(s) still use the placeholder name "New Marker"'});
  var unnamedZones = (P.zones||[]).filter(function(z){ return !z.name || /^new zone$/i.test(z.name.trim()); });
  items.push({label:'Constraint zones have descriptive names', status: unnamedZones.length===0?'pass':'warn',
    detail: unnamedZones.length===0 ? 'All zones have descriptive names' : unnamedZones.length+' zone(s) still use the placeholder name "New Zone"'});
  [
    'Tab through the exported site with a keyboard only — check you can reach and use the scene nav, drawer, and feedback form.',
    'Try it with a screen reader (VoiceOver on Mac, NVDA on Windows) at least once before publishing.',
    'Make sure marker and zone descriptions make sense when read aloud, not just visually.',
    'If any lightbox embeds video, make sure that video has captions.'
  ].forEach(function(msg){ items.push({label:msg, status:'manual', detail:''}); });
  return items;
}
