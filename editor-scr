function mkGJ() { return {type:'FeatureCollection',features:P.markers.map(function(m){return{type:'Feature',geometry:{type:'Point',coordinates:m.coords},properties:{name:m.name,color:m.color}};})}; }
function smoothPolygon(coords, r) {
  if(!r || r < 0.01) return coords;
  var pts = coords.slice(0, coords.length-1);
  var n = pts.length;
  var out = [];
  for(var i=0; i<n; i++) {
    var prev=pts[(i+n-1)%n], cur=pts[i], next=pts[(i+1)%n];
    // Compute edge lengths to scale rounding proportionally
    var d1=Math.sqrt(Math.pow(cur[0]-prev[0],2)+Math.pow(cur[1]-prev[1],2));
    var d2=Math.sqrt(Math.pow(next[0]-cur[0],2)+Math.pow(next[1]-cur[1],2));
    var t = r * Math.min(d1, d2) * 0.3; // gentle: 30% of shortest edge, scaled by r
    var p1=[cur[0]-(cur[0]-prev[0])/d1*t, cur[1]-(cur[1]-prev[1])/d1*t];
    var p2=[cur[0]+(next[0]-cur[0])/d2*t, cur[1]+(next[1]-cur[1])/d2*t];
    for(var s=0;s<=6;s++){var u=s/6,v=1-u;out.push([v*v*p1[0]+2*v*u*cur[0]+u*u*p2[0],v*v*p1[1]+2*v*u*cur[1]+u*u*p2[1]]);}
  }
  out.push(out[0]);
  return out;
}
function lnGJ() {
  var sceneId = P.scenes[AS] ? P.scenes[AS].id : null;
  var features = [];
  (P.lines||[]).forEach(function(ln) {
    if(!ln.geojson) return;
    var ls = ln.scenes||[];
    if(ls.length>0 && (!sceneId || ls.indexOf(sceneId)<0)) return;
    try {
      var gj = JSON.parse(ln.geojson);
      var geoms = [];
      if(gj.type==='FeatureCollection') gj.features.forEach(function(f){if(f.geometry.type==='LineString'||f.geometry.type==='MultiLineString')geoms.push(f.geometry);});
      else if(gj.type==='Feature') geoms.push(gj.geometry);
      else if(gj.type==='LineString'||gj.type==='MultiLineString') geoms.push(gj);
      var dash = ln.dash==='dashed'?[6,4]:ln.dash==='dotted'?[1,3]:[1,0];
      geoms.forEach(function(g){
        features.push({type:'Feature',geometry:g,properties:{
          color:ln.color||'#fff', width:ln.width||3, opacity:ln.opacity||1,
          dash:ln.dash||'solid',
          label:ln.showLabel?(ln.labelText||ln.name||''):'',
          labelSize:ln.labelSize||12, labelColor:ln.labelColor||'#fff', labelBg:ln.labelBg||'rgba(0,0,0,0.85)'
        }});
      });
    } catch(e) {}
  });
  return {type:'FeatureCollection', features:features};
}
function lnPtsGJ() {
  var sceneId = P.scenes[AS] ? P.scenes[AS].id : null;
  var features = [];
  (P.lines||[]).forEach(function(ln) {
    if(!ln.showEndpoints||!ln.geojson) return;
    var ls = ln.scenes||[];
    if(ls.length>0 && (!sceneId || ls.indexOf(sceneId)<0)) return;
    try {
      var gj = JSON.parse(ln.geojson);
      var geoms = [];
      if(gj.type==='FeatureCollection') gj.features.forEach(function(f){if(f.geometry.type==='LineString'||f.geometry.type==='MultiLineString')geoms.push(f.geometry);});
      else if(gj.type==='Feature') geoms.push(gj.geometry);
      else if(gj.type==='LineString'||gj.type==='MultiLineString') geoms.push(gj);
      geoms.forEach(function(g){
        var coords = g.type==='LineString'?[g.coordinates]:g.coordinates;
        coords.forEach(function(line){
          if(line.length>0) features.push({type:'Feature',geometry:{type:'Point',coordinates:line[0]},properties:{color:ln.color||'#fff',opacity:ln.opacity||1,radius:ln.endpointRadius||5}});
          if(line.length>1) features.push({type:'Feature',geometry:{type:'Point',coordinates:line[line.length-1]},properties:{color:ln.color||'#fff',opacity:ln.opacity||1,radius:ln.endpointRadius||5}});
        });
      });
    } catch(e) {}
  });
  return {type:'FeatureCollection', features:features};
}
