    html += '<div class="nt" style="margin-bottom:8px">Or tick specific scenes:</div>';
    (P.scenes||[]).forEach(function(sc,si) {
      var checked = (ov.scenes||[]).indexOf(sc.id) >= 0;
      html += '<div class="lr" style="margin-bottom:5px"><span class="ll">'+h(sc.label||'Scene '+(si+1))+'</span>';
      html += '<button class="tg'+(checked?' on':'')+'" id="ov-sc-'+si+'"></button></div>';
    });
