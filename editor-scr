function renderScenes() {
  var ul = el('scene-list');
  ul.innerHTML = '';
  P.scenes.forEach(function(sc, i) {
    var div = mk('div', 'si' + (i===AS?' on':''));
    div.innerHTML =
      '<span class="in">' + String(i+1).padStart(2,'0') + '</span>' +
      '<span class="nm">' + h(sc.label||'Untitled') + '</span>' +
      '<div class="ia">' +
        '<button class="ib" data-i="'+i+'" data-a="up" title="Move up">'+lucideSVG('arrow-up',12,'currentColor')+'</button>' +
        '<button class="ib" data-i="'+i+'" data-a="dn" title="Move down">'+lucideSVG('arrow-down',12,'currentColor')+'</button>' +
        '<button class="ib" data-i="'+i+'" data-a="dup" title="Duplicate">'+lucideSVG('copy',12,'currentColor')+'</button>' +
        '<button class="ib d" data-i="'+i+'" data-a="del" title="Delete">'+lucideSVG('trash-2',12,'currentColor')+'</button>' +
      '</div>';
    div.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-a]');
      if (btn) {
        e.stopPropagation();
        var idx = parseInt(btn.dataset.i);
        var act = btn.dataset.a;
        if (act==='up') { mvScene(idx,-1); }
        else if (act==='dn') { mvScene(idx,1); }
        else if (act==='dup') { dupScene(idx); }
        else if (act==='del') { delScene(idx); }
        return;
      }
      selScene(i);
    });
    ul.appendChild(div);
  });
}
function selScene(i) { AS=i; AM=null; AZ=null; ensureEditorTab(); renderScenes(); renderRightPanel(); updatePreview(); }
function addScene() {
  markDirty(); P.scenes.push({id:'s'+Date.now(),label:'New Scene',title:'Scene Title',body:'<p>Add your scene description here.</p>',camera:{zoom:15,pitch:30,bearing:0,duration:2000},layers:{redline:true,context:false,constraints:false,buildings3d:false,orbit:false,buildings:true}});
  AS = P.scenes.length-1;
  ensureEditorTab(); renderScenes(); renderRightPanel();
}
function delScene(i) {
  if (P.scenes.length<=1) { alert('Need at least one scene.'); return; }
  if (!confirm('Delete this scene?')) return;
  P.scenes.splice(i,1); markDirty();
  if (AS >= P.scenes.length) AS = P.scenes.length-1;
  renderScenes(); renderRightPanel();
}
function mvScene(i, d) {
  var j = i+d;
  if (j<0||j>=P.scenes.length) return;
  var tmp = P.scenes[i]; P.scenes[i]=P.scenes[j]; P.scenes[j]=tmp;
  if (AS===i) AS=j; else if (AS===j) AS=i;
  renderScenes();
}
function dupScene(i) {
  var copy = JSON.parse(JSON.stringify(P.scenes[i]));
  copy.id = 's'+Date.now();
  copy.label = copy.label + ' (copy)';
  P.scenes.splice(i+1, 0, copy);
  AS = i+1;
  markDirty(); renderScenes(); renderRightPanel();
}

