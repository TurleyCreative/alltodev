<script>
var DASH_PW = "Test";
var FB_URL = "https://default8f1dd42696094019b47568f7400a1c.8a.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/16/workflows/26807660fcee4c739fa5548a503e6c98/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=p0uFHvfLb2ct9ujjxilkJFuRkFE3oXWJo2OxyNlo06w";
var CD_URL = "https://default8f1dd42696094019b47568f7400a1c.8a.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/31/workflows/c180228f8e1f42129d4aeecd7b7bb7ee/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=-HMW1n44Gu6b5-JdhI62zQy925VEHzPaG3EezMebHl4";
var SQ_URL = "https://default8f1dd42696094019b47568f7400a1c.8a.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/29/workflows/5413b636ee8d4cbe916f05ecf4077325/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=OKZNa7kgaGc_IBJvKXj53Q9tXuEFBlALjKr8f77CfZs";
var APPROVED_EMAILS = ["john.davison@turley.co.uk","chris.hemsley@turley.co.uk"];
var CATCHUP_URL = "mailto:chris.hemsley@turley.co.uk";
function renderRadial(pos, neu, neg, total){
  var svg = document.getElementById("dash-radial-svg");
  var legend = document.getElementById("dash-radial-legend");
  var NS = "http://www.w3.org/2000/svg";
  var items = [
    {label:"Positive", value:pos, color:"#3a8f6f", r:90},
    {label:"Neutral", value:neu, color:"#c7cbd1", r:68},
    {label:"Negative", value:neg, color:"#5b616b", r:46}
  ];
  var strokeW = 15;
  svg.innerHTML = "";
  items.forEach(function(it){
    var c = 2*Math.PI*it.r;
    var share = total>0 ? it.value/total : 0;
    var bg = document.createElementNS(NS,"circle");
    bg.setAttribute("cx","100"); bg.setAttribute("cy","100"); bg.setAttribute("r",it.r);
    bg.setAttribute("fill","none"); bg.setAttribute("stroke","#e9ebee"); bg.setAttribute("stroke-width",strokeW);
    svg.appendChild(bg);
    var fg = document.createElementNS(NS,"circle");
    fg.setAttribute("cx","100"); fg.setAttribute("cy","100"); fg.setAttribute("r",it.r);
    fg.setAttribute("fill","none"); fg.setAttribute("stroke",it.color); fg.setAttribute("stroke-width",strokeW);
    fg.setAttribute("stroke-linecap","round");
    fg.setAttribute("stroke-dasharray", c.toFixed(2));
    fg.setAttribute("stroke-dashoffset", (c*(1-share)).toFixed(2));
    fg.setAttribute("transform","rotate(-90 100 100)");
    svg.appendChild(fg);
  });
  legend.innerHTML = items.map(function(it){
    return "<div class=\"dash-radial-legend-item\"><span class=\"dash-radial-legend-dot\" style=\"background:"+it.color+"\"></span>"+it.label+" <span class=\"dash-radial-legend-count\">"+it.value+"</span></div>";
  }).join("");
}
function checkAuth(){ try{ return sessionStorage.getItem("allto_dash_auth")==="1"; }catch(e){ return false; } }
function setAuth(){ try{ sessionStorage.setItem("allto_dash_auth","1"); }catch(e){} }
function showDashboard(){ document.getElementById("dash-gate").style.display="none"; document.getElementById("dash-content").style.display="block"; loadAll(); }
var _printDateEl=document.getElementById("dash-print-date");
if(_printDateEl) _printDateEl.textContent = "Generated " + new Date().toLocaleDateString(undefined,{year:"numeric",month:"long",day:"numeric"});
var _exportBtn=document.getElementById("dash-export-btn");
if(_exportBtn) _exportBtn.addEventListener("click", function(){ window.print(); });
Array.prototype.forEach.call(document.querySelectorAll(".dash-range-btn"), function(btn){
  btn.addEventListener("click", function(){
    Array.prototype.forEach.call(document.querySelectorAll(".dash-range-btn"), function(b){ b.classList.remove("on"); });
    btn.classList.add("on");
    gaRange = btn.getAttribute("data-range");
    var customEl = document.getElementById("dash-ga-custom");
    if(gaRange==="custom"){
      customEl.style.display="flex";
      var toEl=document.getElementById("dash-ga-to"), fromEl=document.getElementById("dash-ga-from");
      if(!toEl.value){ var now=new Date(); toEl.value=now.toISOString().slice(0,10); }
      if(!fromEl.value){ var past=new Date(Date.now()-13*86400000); fromEl.value=past.toISOString().slice(0,10); }
      loadGA();
    } else {
      customEl.style.display="none";
      loadGA();
    }
  });
});
var _gaApplyBtn=document.getElementById("dash-ga-apply");
if(_gaApplyBtn) _gaApplyBtn.addEventListener("click", loadGA);
if(checkAuth()){ showDashboard(); }
document.getElementById("dash-gate-form").addEventListener("submit", function(e){
  e.preventDefault();
  var emailInput = document.getElementById("dash-email-input");
  var email = emailInput ? emailInput.value.trim().toLowerCase() : "";
  var pw = document.getElementById("dash-pw-input").value;
  if(APPROVED_EMAILS.length && APPROVED_EMAILS.indexOf(email)===-1){
    document.getElementById("dash-gate-error").textContent = "That email isn\u2019t on the approved list.";
    return;
  }
  if(DASH_PW && pw===DASH_PW){ setAuth(); showDashboard(); }
  else { document.getElementById("dash-gate-error").textContent = "Incorrect password."; }
});
function daysAgo(n){ return Date.now() - n*86400000; }
function parseTs(s){
  if(!s) return NaN;
  var m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2}):(\d{2})/.exec(s);
  if(m) return new Date(+m[3], +m[1]-1, +m[2], +m[4], +m[5], +m[6]).getTime();
  return Date.parse(s);
}
function countRecent(rows, days){
  var cutoff = daysAgo(days);
  return rows.filter(function(r){ var t = r && r.timestamp ? parseTs(r.timestamp) : NaN; return !isNaN(t) && t>=cutoff; }).length;
}
function renderPill(id, n, label){
  var el = document.getElementById(id);
  if(!el) return;
  el.innerHTML = n>0 ? "<span class=\"dash-pill\">+"+n+" "+label+"</span>" : "";
}
function loadAll(){ loadGA(); loadFeedback(); loadCodesign(); loadQuestions(); }
var gaRange = "months";
function gaDataset(range, customDays){
  if(range==="days"){
    var vals=[]; for(var i=0;i<30;i++){ vals.push(Math.round(60 + Math.sin(i/3)*16 + i*1.6 + (i%5)*4)); }
    return {vals:vals, pillText:"+8% vs yesterday"};
  }
  if(range==="custom"){
    var n=Math.max(4,Math.min(60,customDays||14)); var vals=[];
    for(var j=0;j<n;j++){ vals.push(Math.round(70 + Math.sin(j/2.5)*18 + j*1.2)); }
    return {vals:vals, pillText:n+"-day range"};
  }
  return {vals:[420,460,410,530,610,590,700,680,750,820,860,900], pillText:"+12% vs last month"};
}
function loadGA(){
  var customDays=null;
  if(gaRange==="custom"){
    var f=document.getElementById("dash-ga-from").value, t=document.getElementById("dash-ga-to").value;
    if(f&&t){ customDays=Math.max(1, Math.round((new Date(t)-new Date(f))/86400000)+1); }
  }
  var ds=gaDataset(gaRange, customDays);
  var demo=ds.vals;
  var total=demo.reduce(function(a,b){return a+b;},0);
  document.getElementById("dash-ga-total").textContent = total.toLocaleString();
  document.getElementById("dash-ga-pill").innerHTML = "<span class=\"dash-pill\">"+ds.pillText+"</span>";
  var svg=document.getElementById("dash-ga-spark");
  var max=Math.max.apply(null,demo), min=Math.min.apply(null,demo);
  var pts=demo.map(function(v,i){ var x=(i/(demo.length-1))*200; var y=50-((v-min)/(max-min||1))*44-3; return x+","+y; }).join(" ");
  svg.innerHTML="<polyline points=\""+pts+"\" fill=\"none\" stroke-width=\"2\"/>";
}
function loadFeedback(){
  if(!FB_URL){ document.getElementById("dash-fb-total").textContent="Not connected"; document.getElementById("dash-fb-unique").textContent="Not connected"; return; }
  fetch(FB_URL).then(function(r){return r.json();}).then(function(rows){
    if(!Array.isArray(rows)) throw new Error();
    var pos=0,neg=0,neu=0;
    var visitors={};
    rows.forEach(function(r){
      var c=(r.category||"").toLowerCase();
      if(c==="support") pos++; else if(c==="object") neg++; else neu++;
      if(r.visitorId) visitors[r.visitorId]=true;
    });
    document.getElementById("dash-fb-total").textContent = rows.length;
    renderPill("dash-fb-pill", countRecent(rows,7), "this week");
    var uniqueCount = Object.keys(visitors).length;
    document.getElementById("dash-fb-unique").textContent = uniqueCount || "—";
    document.getElementById("dash-fb-unique-sub").textContent = rows.length ? Math.round((uniqueCount/rows.length)*100)+"% of "+rows.length+" pins" : "Have Your Say visitors";
    document.getElementById("dash-fb-sentiment").innerHTML =
      "<div class=\"dash-sentiment-item dash-sentiment-pos\"><div class=\"dash-sentiment-num\">"+pos+"</div><div class=\"dash-sentiment-lbl\">Positive</div></div>"
      +"<div class=\"dash-sentiment-item dash-sentiment-neu\"><div class=\"dash-sentiment-num\">"+neu+"</div><div class=\"dash-sentiment-lbl\">Neutral</div></div>"
      +"<div class=\"dash-sentiment-item dash-sentiment-neg\"><div class=\"dash-sentiment-num\">"+neg+"</div><div class=\"dash-sentiment-lbl\">Negative</div></div>";
    var total=pos+neg+neu;
    var card=document.getElementById("dash-sentiment-card");
    var scoreEl=document.getElementById("dash-sentiment-score");
    var tagEl=document.getElementById("dash-sentiment-tag");
    var totalEl=document.getElementById("dash-sentiment-total");
    var msgEl=document.getElementById("dash-sentiment-msg");
    var ctaEl=document.getElementById("dash-sentiment-cta");
    if(total>0){
      var pct=Math.round((pos/total)*100);
      var negShare=neg/total;
      var tone,tag,msg;
      if(pct>=55 && negShare<0.3){ tone="tone-positive"; tag="Mostly Positive"; msg="Engagement is looking strong \u2014 nothing needs attention right now."; }
      else if(pct<35 || negShare>=0.45){ tone="tone-attention"; tag="Needs Attention"; msg="Let\u2019s work on this, book a catch up now."; }
      else { tone="tone-mixed"; tag="Mixed"; msg="A mix of feedback so far \u2014 worth keeping an eye on."; }
      card.className="dash-card dash-tile-sentiment "+tone;
      scoreEl.textContent=pct+"%";
      tagEl.textContent=tag;
      totalEl.textContent=total;
      msgEl.innerHTML = tone==="tone-attention" ? msg : "From "+total+" Have Your Say responses";
      if(tone==="tone-attention" && CATCHUP_URL){ ctaEl.href=CATCHUP_URL; ctaEl.style.display="block"; } else { ctaEl.style.display="none"; }
      renderRadial(pos, neu, neg, total);
    } else {
      scoreEl.textContent="—";
      tagEl.textContent="No data yet";
      ctaEl.style.display="none";
      document.getElementById("dash-radial-svg").innerHTML="";
      document.getElementById("dash-radial-legend").innerHTML="";
    }
  }).catch(function(){ document.getElementById("dash-fb-total").textContent="Could not load"; document.getElementById("dash-fb-unique").textContent="Could not load"; document.getElementById("dash-sentiment-tag").textContent="Could not load"; });
}
function loadQuestions(){
  if(!SQ_URL){ document.getElementById("dash-sq-total").textContent="Not connected"; return; }
  fetch(SQ_URL).then(function(r){return r.json();}).then(function(rows){
    if(!Array.isArray(rows)) throw new Error();
    document.getElementById("dash-sq-total").textContent = rows.length;
    renderPill("dash-sq-pill", countRecent(rows,7), "this week");
  }).catch(function(){ document.getElementById("dash-sq-total").textContent="Could not load"; });
}
var GREEN_SHADES = ["#1f5c45","#3a8f6f","#6fbb96","#a8dcc0","#c9e9d8"];
function loadCodesign(){
  var status=document.getElementById("dash-cd-status");
  if(!CD_URL){ if(status)status.textContent="Not connected"; return; }
  fetch(CD_URL).then(function(r){return r.json();}).then(function(rows){
    if(!Array.isArray(rows)) throw new Error();
    var valid=rows.filter(function(r){return r&&r.choice;});
    if(!valid.length){ if(status)status.textContent = rows.length ? "Found responses but couldn\u2019t read them \u2014 check the sheet\u2019s column headers." : "No responses yet."; document.getElementById("dash-cd-total").textContent="0"; return; }
    if(status) status.textContent="";
    var counts={};
    valid.forEach(function(r){ counts[r.choice]=(counts[r.choice]||0)+1; });
    var ranked=Object.keys(counts).map(function(k){return {label:k,count:counts[k]};}).sort(function(a,b){return b.count-a.count;});
    var max=ranked[0].count;
    document.getElementById("dash-cd-total").textContent = valid.length;
    document.getElementById("dash-cd-sub").textContent = "Top pick: "+ranked[0].label;
    var list=document.getElementById("dash-cd-list");
    list.innerHTML = ranked.slice(0,5).map(function(r,i){
      var pct = Math.round((r.count/max)*100);
      var color = GREEN_SHADES[Math.min(i,GREEN_SHADES.length-1)];
      return "<div class=\"dash-cd-row\"><div class=\"dash-cd-row-label\">"+r.label+"</div><div class=\"dash-cd-row-track\"><div class=\"dash-cd-row-fill\" style=\"width:"+pct+"%;background:"+color+"\"></div></div><div class=\"dash-cd-row-count\">"+r.count+"</div></div>";
    }).join("");
  }).catch(function(){ if(status)status.textContent="Could not load results."; });
}
document.querySelectorAll(".dash-info-btn").forEach(function(btn){
  btn.addEventListener("click", function(e){
    e.stopPropagation();
    var tip=document.getElementById("dash-tooltip");
    var already = tip.classList.contains("show") && tip.dataset.owner===btn.dataset.info;
    if(already){ tip.classList.remove("show"); return; }
    tip.textContent = btn.dataset.info;
    tip.dataset.owner = btn.dataset.info;
    var r = btn.getBoundingClientRect();
    var left = Math.min(r.left, window.innerWidth - 256);
    if(left<12) left=12;
    tip.style.top = (r.bottom+8)+"px";
    tip.style.left = left+"px";
    tip.classList.add("show");
  });
});
document.addEventListener("click", function(){ var tip=document.getElementById("dash-tooltip"); if(tip) tip.classList.remove("show"); });
</script>
