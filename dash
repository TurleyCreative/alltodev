}.dash-sentiment{display:flex;gap:16px;margin-top:auto;padding-top:20px}.dash-sentiment-item{flex:1;text-align:center}.dash-sentiment-num{font-size:26px;font-weight:500}.dash-sentiment-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#8b909b;margin-top:4px;font-weight:500}.dash-sentiment-pos .dash-sentiment-num{color:#3a8f6f}.dash-sentiment-neg .dash-sentiment-num{color:#5b616b}.dash-sentiment-neu .dash-sentiment-num{color:#a7abb3}.dash-sentiment-tag{font-size:13px;font-weight:500;padding:6px 14px;border-radius:100px;background:#fff}.dash-radial{display:block;width:100%;max-width:230px;margin:8px auto 0;flex:1;min-height:0}.dash-radial-legend{display:flex;flex-wrap:wrap;gap:14px 22px;margin-top:8px;justify-content:center}.dash-radial-legend-item{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:500;color:#3a3f47}.dash-radial-legend-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}.dash-radial-legend-count{color:#8b909b;font-weight:400}.tone-positive .dash-sentiment-tag{color:#2f6f52}.tone-mixed .dash-sentiment-tag{color:#6b7280}.tone-attention .dash-sentiment-tag{color:#5b616b}.dash-cta{display:none;margin-top:16px;text-align:center;padding:12px;border-radius:100px;background:#3a8f6f;color:#fff;font-size:13px;font-weight:500;text-decoration:none}.dash-info-btn{position:absolute;top:22px;right:22px;width:22px;height:22px;border-radius:50%;border:none;background:rgba(18,40,64,.08);color:#5b616b;font-size:11px;font-weight:700;font-style:italic;font-family:Georgia,"Times New Roman",serif;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;padding:0}.dash-tooltip{position:fixed;max-width:240px;background:#20242b;color:#fff;font-size:12px;font-weight:400;line-height:1.5;padding:12px 15px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:80;display:none}.dash-tooltip.show{display:block}.dash-cd-list{margin-top:16px;display:flex;flex-direction:column;gap:10px}.dash-cd-row{display: